#include "dkli.dkh"
#!
module "config.dk"
{
    // _STATIC RESOURCES
    @CSS_MAIN = "/$/inventario/css/main.css"
    @JS_MAIN = "/$/inventario/js/main.js"
    @JS_MOVINV = "/$/inventario/js/movinv.js"

    // _PACKAGE
    @URL_BUSCAR_ALMACEN = "/!/inventario/movimiento/?_view=almacen&s=@search"
    @URL_BUSCAR_CATEGORIA = "/!/inventario/movimiento/?_view=categoria&s=@search"
    @URL_BUSCAR_PRODUCTO = "/!/inventario/movimiento/?_view=producto&s=@search"

    @MENU = "/!/inventario/"

    @INVENTARIO = "/!/inventario/movimiento/"
    @INV_ADD_ENTRADA = "/!/inventario/movimiento/_new/entrada/"
    @INV_ADD_SALIDA = "/!/inventario/movimiento/_new/salida/"
    @INV_ADD_TRASPASO = "/!/inventario/movimiento/_new/traspaso/"
    @INV_GET_DOCUMENTO = "/!/inventario/cardex/@_doc/"

    new @icons
    {
        @"add_row": '<svg class="icon icon-tabler icon-tabler-row-insert-top" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h24v24H0z" fill="none" stroke="none"/><path d="M4 18v-4a1 1 0 0 1 1 -1h14a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-14a1 1 0 0 1 -1 -1z"/><path d="M12 9v-4"/><line x1="10" x2="14" y1="7" y2="7"/></svg>'
        @"remove_row": '<svg height="16" id="icon" viewBox="0 0 32 32" width="16" xmlns="http://www.w3.org/2000/svg"><defs><style>.cls-1 {fill: none;}</style></defs><path d="M24,30H4a2.0021,2.0021,0,0,1-2-2V22a2.0021,2.0021,0,0,1,2-2H24a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,24,30ZM4,22H3.9985L4,28H24V22Z"/><polygon points="30 3.41 28.59 2 25 5.59 21.41 2 20 3.41 23.59 7 20 10.59 21.41 12 25 8.41 28.59 12 30 10.59 26.41 7 30 3.41"/><path d="M4,14V8H18V6H4A2.0023,2.0023,0,0,0,2,8v6a2.0023,2.0023,0,0,0,2,2H26V14Z"/><rect class="cls-1" data-name="&lt;Transparent Rectangle&gt;" height="16" id="_Transparent_Rectangle_" width="16"/></svg>'
        @"insert_row": '<svg height="16" id="icon" viewBox="0 0 32 32" width="16" xmlns="http://www.w3.org/2000/svg"><defs><style>.cls-1 {fill: none;}</style></defs><path d="M28,12H10a2.0021,2.0021,0,0,1-2-2V4a2.0021,2.0021,0,0,1,2-2H28a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,28,12ZM10,4v6H28V4Z"/><path d="M28,30H10a2.0021,2.0021,0,0,1-2-2V22a2.0021,2.0021,0,0,1,2-2H28a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,28,30ZM10,22v6H28V22Z"/><polygon points="9 16 3.414 10.414 2 11.828 6.172 16 2 20.172 3.414 21.586 9 16"/><rect class="cls-1" data-name="&lt;Transparent Rectangle&gt;" height="16" id="_Transparent_Rectangle_" width="16"/></svg>'
        @"file_check": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-check" viewBox="0 0 16 16"><path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z"/><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/></svg>'
    } 
}