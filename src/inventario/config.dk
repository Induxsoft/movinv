#include "dkli.dkh"
#!
module "config.dk"
{
    // cstatusseries
    @stt_serie_disponible = 1
    @stt_serie_vendido = 2
    @stt_serie_devuelto_a_proveedor = 3
    @stt_serie_devuelto_por_cliente = 4
    @stt_serie_ensamblado = 5
    @stt_serie_no_disponible = 6

    @mEntrada = 1
    @mSalida = 2
    @mTraspaso = 3
    
    // _STATIC RESOURCES
    @CSS_MAIN = "/$/inventario/css/main.css"
    @JS_MAIN = "/$/inventario/js/main.js"
    @JS_MOVINV = "/$/inventario/js/movinv.js"
    @JS_FILTER = "/$/inventario/js/filter.js"

    // _PACKAGE
    @URL_BUSCAR_ALMACEN = "/!/inventario/movimiento/?_view=almacen&s=@search"
    @URL_BUSCAR_CATEGORIA = "/!/inventario/movimiento/?_view=categoria&s=@search"
    @URL_BUSCAR_PRODUCTO = "/!/inventario/movimiento/?_view=producto&s=@search"
    @URL_BUSCAR_MOVIMIENTO = "/!/inventario/movimiento/?_view=buscar-cardex&s=@search"
    @URL_BUSCAR_SERIESP = "/!/inventario/movimiento/?_view=buscar-seriesp&s=@search"
    @URL_BUSCAR_OTRASPASO = "/!/inventario/movimiento/?_view=recepcion&s=@search"
    @URL_OBTENER_LINEAS_XCLASE = "/!/inventario/movimiento/?_view=obtener-lineas&iclase=@iclase"
    @URL_OBTENER_LOTES_DE_PRODUCTO = "/!/inventario/movimiento/?_view=obtener-lotes-de-producto&iproducto=@iproducto&ialmacen=@ialmacen"
    @URL_OBTENER_SERIES_DE_PRODUCTO = "/!/inventario/movimiento/?_view=obtener-series-de-producto&iproducto=@iproducto&ialmacen=@ialmacen"

    @MENU = "/!/inventario/"

    @INVENTARIO = "/!/inventario/movimiento/"
    @INV_ADD_ENTRADA = "/!/inventario/movimiento/_new/entrada/"
    @INV_ADD_SALIDA = "/!/inventario/movimiento/_new/salida/"
    @INV_ADD_TRASPASO = "/!/inventario/movimiento/_new/traspaso/"
    @INV_GET_DOCUMENTO = "/!/inventario/cardex/@id/"
    @INV_GET_EXISTENCIAS = "/!/inventario/movimiento/@id/existencias/"
    @INV_GET_LOTE_SERIE = "/!/inventario/movimiento/@id/lote-serie/"
    @INV_VIEW_OTRASPASO = "/!/inventario/movimiento/{order_num}/recepcion/"

    @INV_MAXMIN = "/!/inventario/maxmin/"
    @INV_NEW_MAXMIN = "/!/inventario/maxmin/_new/"

    @default_max_rows=250

    new @icons
    {
        @"add_row": '<svg class="icon icon-tabler icon-tabler-row-insert-top" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M0 0h24v24H0z" fill="none" stroke="none"/><path d="M4 18v-4a1 1 0 0 1 1 -1h14a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-14a1 1 0 0 1 -1 -1z"/><path d="M12 9v-4"/><line x1="10" x2="14" y1="7" y2="7"/></svg>'
        @"remove_row": '<svg height="16" id="icon" viewBox="0 0 32 32" width="16" xmlns="http://www.w3.org/2000/svg"><defs><style>.cls-1 {fill: none;}</style></defs><path d="M24,30H4a2.0021,2.0021,0,0,1-2-2V22a2.0021,2.0021,0,0,1,2-2H24a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,24,30ZM4,22H3.9985L4,28H24V22Z"/><polygon points="30 3.41 28.59 2 25 5.59 21.41 2 20 3.41 23.59 7 20 10.59 21.41 12 25 8.41 28.59 12 30 10.59 26.41 7 30 3.41"/><path d="M4,14V8H18V6H4A2.0023,2.0023,0,0,0,2,8v6a2.0023,2.0023,0,0,0,2,2H26V14Z"/><rect class="cls-1" data-name="&lt;Transparent Rectangle&gt;" height="16" id="_Transparent_Rectangle_" width="16"/></svg>'
        @"insert_row": '<svg height="16" id="icon" viewBox="0 0 32 32" width="16" xmlns="http://www.w3.org/2000/svg"><defs><style>.cls-1 {fill: none;}</style></defs><path d="M28,12H10a2.0021,2.0021,0,0,1-2-2V4a2.0021,2.0021,0,0,1,2-2H28a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,28,12ZM10,4v6H28V4Z"/><path d="M28,30H10a2.0021,2.0021,0,0,1-2-2V22a2.0021,2.0021,0,0,1,2-2H28a2.0021,2.0021,0,0,1,2,2v6A2.0021,2.0021,0,0,1,28,30ZM10,22v6H28V22Z"/><polygon points="9 16 3.414 10.414 2 11.828 6.172 16 2 20.172 3.414 21.586 9 16"/><rect class="cls-1" data-name="&lt;Transparent Rectangle&gt;" height="16" id="_Transparent_Rectangle_" width="16"/></svg>'
        @"file_check": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-check" viewBox="0 0 16 16"><path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0l3-3z"/><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/></svg>'
        @"ICON_ARROW_CLOCKWISE": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/><path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/></svg>'
        @"ICON_SEARCH": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0"/></svg>'
        @"PRINTER": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16"><path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1"/><path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1"/></svg>'
        @"X": '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16"><path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/></svg>'
    } 
}