#include "dkli.dkh"
#!
module
{
    #include "functions.dkh"

    @dateNow = ndatetime.now()
    @years_back = 10    // años hacia atrás
    @years_forward = 1  // años hacia delante

    get_years::
    {
        yearfrom = ndatetime.add(@dateNow, (@years_back+1)*-1, "y")
        ref list = list.create()
        date = yearfrom

        for i = 1; i < @years_back+(@years_forward+2)
        {
            date = ndatetime.add(date, 1 , 'y')
            do list.add(list, ndatetime.year(date))
        }
        return list
    }

    function print_date_filter(&get, &contentBefore, &contentAfter)
    {
        #$ form(action="./" method="GET" id="form_filter" class="no-print")
        {
            #! tab = field.dnum(get,"tab",1)
            #$ input(type="hidden" name="tab" value="#<tab>" id="input_tab_selected")

            // TABS FILTERS
            ul(class="nav nav-tabs" id="myTab" role="tablist")
            {
                #! if not(isnull(contentBefore)) { that contentBefore }
                #$ li(class="nav-item" role="presentation"){ button(class="nav-link text-secondary py-1 px-2 rounded-0 #<ifstr(tab==0,'active','')>" id="date-range-tab" "data-bs-toggle"="tab" "data-bs-target"="#date-range" type="button" role="tab" "aria-controls"="date-range" "aria-selected"="#<ifstr(tab==0,'true','false')>"){small{$"Rango de fechas"} }}
                li(class="nav-item" role="presentation"){ button(class="nav-link text-secondary py-1 px-2 rounded-0 #<ifstr(tab==1,'active','')>" id="months-tab" "data-bs-toggle"="tab" "data-bs-target"="#months" type="button" role="tab" "aria-controls"="months" "aria-selected"="#<ifstr(tab==0,'true','false')>"){small{$"Ver por cada mes"} }}
                #! if not(isnull(contentAfter)) { that contentAfter } #$
            }

            // CONTROLS FILTERS
            div(class="tab-content p-2 border border-top-0 border-bottom-0" id="myTabContent")
            {
                fieldset(class="tab-pane fade #<ifstr(tab==0,'show active','')>" id="date-range" role="tabpanel" "aria-labelledby"="date-range-tab" "#<ifstr(tab==0,'','disabled')>"="true")
                {
                    div(class="d-flex flex-wrap gap-3" id="options_date_container")
                    {
                        #! range = @@(get,"#range")

                        #$ div(class="form-check m-0 d-flex gap-2 align-items-center") {
                            input(class="form-check-input submit" type="radio" name="range" id="op_r1" value="15" "#<ifstr(range==15,'checked','')>"="true")
                            label(class="form-check-label text-secondary" "for"="op_r1"){small{$"últ. 15 días"}}
                        }
                        div(class="form-check m-0 d-flex gap-2 align-items-center") {
                            input(class="form-check-input submit" type="radio" name="range" id="op_r2" value="30" "#<ifstr(range==30,'checked','')>"="true")
                            label(class="form-check-label text-secondary" "for"="op_r2"){small{$"últ. 30 días"}}
                        }
                        div(class="form-check m-0 d-flex gap-2 align-items-center") {
                            input(class="form-check-input submit" type="radio" name="range" id="op_r3" value="60" "#<ifstr(range==60,'checked','')>"="true")
                            label(class="form-check-label text-secondary" "for"="op_r3"){small{$"últ. 60 días"}}
                        }
                        div(class="form-check m-0 d-flex gap-2 align-items-center") {
                            input(class="form-check-input submit" type="radio" name="range" id="op_r4" value="90" "#<ifstr(range==90,'checked','')>"="true")
                            label(class="form-check-label text-secondary" "for"="op_r4"){small{$"últ. 90 días"}}
                        }
                        div(class="form-check m-0 d-flex gap-2 align-items-center") {
                            input(class="form-check-input" type="radio" name="range" id="op_r5" value="-99" "#<ifstr(range==-99,'checked','')>"="true")
                            label(class="form-check-label text-secondary" "for"="op_r5"){small{$"Personalizado"}}
                        }
                        div(class="d-flex gap-2 align-items-center flex-wrap" id="dates_range_container")
                        {
                            #! 
                            datef = @@(get,"$datefrom")
                            datet = @@(get,"$dateto")
                            if trim(datef) == "" { datef = ndatetime.tostr(str(ndatetime.add(@dateNow, -1, "m")), "yyyy-MM-dd") }
                            if trim(datet) == "" { datet = ndatetime.tostr(str(@dateNow), "yyyy-MM-dd") }
                            
                            #$
                            small(class="text-secondary"){$"Desde:"}
                            div{ input(type="date" name="datefrom" class="form-control form-control-sm rounded-0 text-secondary" value="#<datef>" disabled="true") }
                            small(class="text-secondary"){$"Hasta:"}
                            div{ input(type="date" name="dateto" class="form-control form-control-sm rounded-0 text-secondary" value="#<datet>" disabled="true") }
                            
                            button(type="submit" class="btn btn-sm btn-primary py-0 px-2 d-none" id="btn_dr_accept"){$"Aplicar"}
                            button(type="button" class="btn btn-sm btn-light py-0 px-2 d-none" id="btn_dr_cancel"){$"Cancelar"}
                            button(type="button" class="btn btn-sm btn-secondary py-0 px-2" "#<ifstr(range==-99,'','disabled')>"="true" id="btn_dr_change"){$"Cambiar"}
                        }
                    }
                }
                fieldset(class="tab-pane fade #<ifstr(tab==1,'show active','')>" id="months" role="tabpanel" "aria-labelledby"="months-tab" "#<ifstr(tab==1,'','disabled')>"="true")
                {
                    div(class="d-flex gap-1 align-items-center flex-wrap")
                    {
                        div
                        {
                            select(class="form-select form-select-sm induxsoft-corners" name="year" id="select_year_filter")
                            {
                                #! 
                                ref years = get_years()
                                year = @@(get,'#year')
                                if year == 0 { year = ndatetime.year(@dateNow) }
                                
                                for i = 0; i < list.count(years) {
                                    y = list.num(years,i)
                                    #$ option(value="#<y>" "#<ifstr(year!=y,'','selected')>"="true"){$"#<y>"}
                                }
                            }
                        }
                        div(class="flex-grow-1")
                        {
                            #! month = @@(get, "#month")
                            #$ div(class="btn-group flex-wrap" role="group" id="month_options_container")
                            {
                                input(type="radio" class="btn-check" name="month" id="op_m1" autocomplete="off" value="01" "#<ifstr(month==01,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m1"){small{$"Enero"}}

                                input(type="radio" class="btn-check" name="month" id="op_m2" autocomplete="off" value="02" "#<ifstr(month==02,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m2"){small{$"Febrero"}}

                                input(type="radio" class="btn-check" name="month" id="op_m3" autocomplete="off" value="03" "#<ifstr(month==03,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m3"){small{$"Marzo"}}

                                input(type="radio" class="btn-check" name="month" id="op_m4" autocomplete="off" value="04" "#<ifstr(month==04,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m4"){small{$"Abril"}}

                                input(type="radio" class="btn-check" name="month" id="op_m5" autocomplete="off" value="05" "#<ifstr(month==05,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m5"){small{$"Mayo"}}

                                input(type="radio" class="btn-check" name="month" id="op_m6" autocomplete="off" value="06" "#<ifstr(month==06,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m6"){small{$"Junio"}}

                                input(type="radio" class="btn-check" name="month" id="op_m7" autocomplete="off" value="07" "#<ifstr(month==07,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m7"){small{$"Julio"}}

                                input(type="radio" class="btn-check" name="month" id="op_m8" autocomplete="off" value="08" "#<ifstr(month==08,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m8"){small{$"Agosto"}}

                                input(type="radio" class="btn-check" name="month" id="op_m9" autocomplete="off" value="09" "#<ifstr(month==09,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m9"){small{$"Septiembre"}}

                                input(type="radio" class="btn-check" name="month" id="op_m10" autocomplete="off" value="10" "#<ifstr(month==10,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m10"){small{$"Octubre"}}

                                input(type="radio" class="btn-check" name="month" id="op_m11" autocomplete="off" value="11" "#<ifstr(month==11,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m11"){small{$"Noviembre"}}

                                input(type="radio" class="btn-check" name="month" id="op_m12" autocomplete="off" value="12" "#<ifstr(month==12,'checked','')>"="true")
                                label(class="btn btn-sm btn btn-outline-secondary border radio-btn" "for"="op_m12"){small{$"Diciembre"}}
                            }
                        }
                    }
                }
            }

            script(src="#<@JS_FILTER>"){$""}
            style{$'
                .nav-link.active { color: #000 !important; background-color: #F5F5F5 !important; border-bottom-color: transparent !important; }
                .tab-content { background-color: #F5F5F5 !important; }
                .form-check-label small { font-size: .8rem; }
            '}
        }
    }
}