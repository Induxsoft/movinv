        // @"contacto3" int ref:"contacto" ["sys_pk"] 
        // @"domicilio1" int ref:"domicilio" ["sys_pk"] 
        // @"domicilio2" int ref:"domicilio" ["sys_pk"] 
        // @"domicilio3" int ref:"domicilio" ["sys_pk"] 
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        // @"izona" int ref:"zona" ["sys_pk"] 
        @"tipo" int ref:"tipoproveedor" ["sys_pk"] required
        @"uf_sys_baja" bool 
        @"uf_vueltaviajero" int 
        // @"uf_tipoop" int ref:"tipooperacion" ["sys_pk"] 
    }

    entity "cdocumentos" : "EnumModel" {}
    entity "cformaspago" : "EnumModel" {}
    entity "cstatusadministrativos" : "EnumModel" {}
    entity "cstatusentrega" : "EnumModel" {}
    entity "cstatusfacturacion" : "EnumModel" {}
    entity "cstatusfinancieros" : "EnumModel" {}
    entity "cstatusordenproduccion" : "EnumModel" {}
    entity "cstatusdetallecompra" : "EnumModel" {}
    entity "cstatusdetalleventa" : "EnumModel" {}
    entity "ctasasiva" : "EnumModel" {}

    entity "cconsumo" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
        @"notas" string(2048)
        @"precio" int
        @"ialmacen" int ref:"almacen" ["sys_pk"]
        @"porcentaje_esperado" decimal(19,8)
        @"uf_domiciliocfd" int
        @"uf_expedicioncxc" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_grupoprod" int
    }
    entity "cproduccion" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"almacenmp" int ref:"almacen" ["sys_pk"] required
        @"almacenpt" int ref:"almacen" ["sys_pk"] required
    }
    entity "cliente" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(35) unique required
        @"curp" string(25) unique
        @"descuento" decimal(19,8)
        @"diascredito" int
        @"email" string(80)
        @"fax" string(150)
        @"limitecredito" decimal(19,8)
        @"monedero" decimal(19,8)
        @"nombre" string(150) unique required
        @"notas" memo
        @"precio" decimal(19,8)
        @"puntos" decimal(19,8)
        @"rfc" string(15)
        @"saldo" decimal(19,8)
        @"saldopuntos" decimal(19,8)
        // @"status" int ref:"cstatusorg" ["id"]
        @"telefonos" string(150)
        @"website" string(150)
        // @"agente" int ref:"agente" ["sys_pk"]
        // @"contacto1" int ref:"contacto" ["sys_pk"]
        // @"contacto2" int ref:"contacto" ["sys_pk"]
        // @"contacto3" int ref:"contacto" ["sys_pk"]
        // @"domicilio1" int ref:"domicilio" ["sys_pk"]
        // @"domicilio2" int ref:"domicilio" ["sys_pk"]
        // @"domicilio3" int ref:"domicilio" ["sys_pk"]
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"tipo" int ref:"tipocliente" ["sys_pk"] required
        // @"zona" int ref:"zona" ["sys_pk"]
        @"uf_sys_baja" bool
        @"uf_addenda" bool
        @"regfiscal" string(3)
        // Campos que se utilizan en Cuenta Mestra.
        @"induxsoftnic" string(50)
        @"giro" memo
        @"preciotimbre" decimal(19,8)
        @"color" int
        @"uf_nomcomercial" string(1024)
        @"replegal_nombre" string(255)
        @"replegal_puesto" string(50)
        @"replegal_email" string(255)
        @"replegal_telefono" string(50)
        @"replegal_telefonoaux" string(50)
        @"contactof_nombre" string(255)
        @"contactof_puesto" string(50)
        @"contactof_email" string(255)
        @"contactof_telefono" string(50)
        @"contactof_telefonoaux" string(50)
        @"contactotec_nombre" string(255)
        @"contactotec_puesto" string(50)
        @"contactotec_email" string(255)
        @"contactotec_telefono" string(50)
        @"contactotec_telefonoaux" string(50)
    }
    entity "foliosdocumentos" : "TableModel"
    {
        @"cancelado" bool required
        @"fecha" date required
        @"folio" int required
        @"block" int ref:"blockdocumentos" ["sys_pk"] required

        index "idx_foliodoc" unique
        {
            field "folio"
            field "block"
        }
    }
    entity "tipoproveedor" : "TableModel"
    {
        @"codigo" string(15) unique required
        @"descripcion" string(50) unique required
        @"notas" string(4096) 
    }
    entity "tipocliente" : "TableModel"
    {
        @"codigo" string(15) unique required
        @"descripcion" string(50) unique required
        @"notas" string(4096) 
    }
    entity "blockdocumentos" : "TableModel"
    {
        @"activo" bool required
        @"datos" string(255)
        @"documento" int ref:"cdocumentos" ["id"] required
        @"finicial" int required
        @"fiscal" bool required
        @"fultimo" int required
        @"idcontrol" string(32)
        @"numcontrol" int
        @"serie" string(10)
        @"uf_cfdfolio" int
        @"uf_cfdi_info" int
    }

    // Información de la aplicación
    entity "sys_app_catalog"
    {
        @"pack_id" string(32) required
        @"app_id" string(32) key
        @"app_title" string(255)
        @"created" datetime required
        @"app_info" mmemo
    }
    // Categoria de la aplicación
    entity "sys_app_category"
    {
        @"id" string(32) key
        @"title" string(255) required
    }
    // Recursos de la aplicación
    entity "sys_app_shortcut" 
    {
        @"id" string(32) key
        @"title" string(255) required
        @"icon96x96" string(1024) required
        @"src" string(1024) required
        @"_blank" bool
        @"appid" ref : "sys_app_catalog"
        @"cat" ref :"sys_app_category"
    }
}