#include "ddm.dkh"
model "movinv"
{
    /* 
    MOVIMIENTOS DE INVENTARIO
    =======================================================================
    */

    #include "induxsoft.abstracts.ddm"

    // Cada movimiento tiene relacionada una categoría para obtener reportes.
    entity "categoria" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
        @"pmensual" decimal(18,8)
        @"tipo" int ref:"ctiposcategorias" ["id"]
        @"padre" int ref:"categoria" ["sys_pk"]
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
    }
    // Contiene los datos generales del movimiento
    entity "cardex" : "TableModel"
    {
        @"aplicado" bool
        @"descripcion" string(8192)
        @"fecha" date
        @"referencia" string(255) unique required
        @"valuado" bool
        @"doccompra" int ref:"compra" ["sys_pk"]
        @"docorden" int ref:"orden" ["sys_pk"]
        @"docventa" int ref:"venta" ["sys_pk"]
        @"icategoria" int ref:"categoria" ["sys_pk"] required
    }
    // Contiene cada partida del movimiento (la entrada o salida de un producto)
    entity "dcardex" : "TableModel"
    {
        @"abonos" decimal(18,8)
        @"auditado" bool
        @"cargos" decimal(18,8)
        @"contabilizado" bool
        @"cpromedio" decimal(18,8)
        @"entradas" decimal(18,8)
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(30)
        @"resto" decimal(18,8)
        @"salidas" decimal(18,8)
        @"tipocambio" decimal(18,8)
        @"valuado" bool
        @"ialmacen" ref:"almacen" required
        @"ilote" ref:"lote"
        @"iproducto" ref:"producto" required
        @"iserie" ref:"serie"
        @"rcompra" ref:"dcompra"
        @"rventa" ref:"dventa"
        @"fk_cardex_movimientos" ref:"cardex" required
    }
    // Contiene identificadores de grupos de productos de características similares o iguales
    entity "lote" : "TableModel"
    {
        @"entradas" decimal(18,8)
        @"existencia" decimal(18,8)
        @"fcaducidad" date
        @"fentrada" date
        @"numero" string(50) unique required
        @"iproducto" int ref:"producto" ["sys_pk"] required
    }
    // Contiene información e identificación de un producto
    entity "serie" : "TableModel"
    {
        @"fentrada" date 
        @"fventa" date 
        @"notas" string(4096) 
        @"numero" string(50) unique required
        @"status" int ref:"cstatusseries" ["id"] required
        @"doccompra" int ref:"compra" ["sys_pk"] 
        @"docventa" int ref:"venta" ["sys_pk"] 
        @"ialmacen" int ref:"almacen" ["sys_pk"] 
        @"iensamble" int ref:"serie" ["sys_pk"] 
        @"ilote" int ref:"lote" ["sys_pk"] 
        @"iproducto" int ref:"producto" ["sys_pk"] required
    }
    // Almacen de productos
    entity "almacen" : "TableModel"
    {
        @"codcuenta" string(50) unique
        @"codigo" string(10) unique required
        @"descripcion" string(50) unique required
        @"email" string(50)
        @"fax" string(150)
        @"telefonos" string(150)
        @"website" string(150)
        @"domicilio1" int ref:"domicilio" ["sys_pk"]
        @"uf_movremoto" bool
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_formaproduccion" int
    }
    // Registro de lotes por almacen
    entity "clotexalmacen" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"ialmacen" int ref:"almacen" ["sys_pk"] required
        @"fk_lote_exisxalmacen" int ref:"lote" ["sys_pk"] required
    }
    // Contiene el saldo y existencia de cada producto en cada almacén
    entity "existencias" : "TableModel"
    {
        @"existencia" decimal(18,8)
        @"saldo" decimal(18,8)
        @"ialmacen" int ref:"almacen" ["sys_pk"] required
        @"fk_producto_iexistencias" int ref:"producto" ["sys_pk"] required
    }
    // Contiene información del producto además del saldo y existencia de todos los almacenes de ese producto
    entity "producto" : "TableModel"
    {
        @"adicional" bool
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"codbar1" string(35) unique
        @"codbar2" string(35) unique
        @"codbar3" string(35) unique
        @"codigo" string(35) unique required
        @"color" int
        @"comision" decimal(18,8)
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"costopromedio" decimal(18,8)
        @"costoultimo" decimal(18,8)
        @"data1" string(500)
        @"data2" string(500)
        @"data3" string(500)
        @"desc2" decimal(18,8)
        @"desc3" decimal(18,8)
        @"desc4" decimal(18,8)
        @"desc5" decimal(18,8)
        @"descripcion" string(150) unique required
        @"diasentrega" int
        @"existencia" decimal(18,8)
        @"factorb" decimal(18,8)
        @"factorc" decimal(18,8)
        @"factord" decimal(18,8)
        @"factore" decimal(18,8)
        @"flaglimites" bool
        @"flagutilidad" bool
        @"formacomision" ref:"cformacomisionproducto"
        @"iclase" ref:"cclaseproducto" required
        @"itipo" ref:"ctipoproducto" required
        @"lim2" decimal(18,8)
        @"lim3" decimal(18,8)
        @"lim4" decimal(18,8)
        @"lim5" decimal(18,8)
        @"maximo" decimal(18,8)
        @"metodovaluacion" ref:"cmetodosvaluacion" required
        @"minimo" decimal(18,8)
        @"notas" memo
        @"padic1" decimal(18,8)
        @"padic2" decimal(18,8)
        @"padic3" decimal(18,8)
        @"padic4" decimal(18,8)
        @"padic5" decimal(18,8)
        @"ppuntos" decimal(18,8)
        @"precio1" decimal(18,8)
        @"precio2" decimal(18,8)
        @"precio3" decimal(18,8)
        @"precio4" decimal(18,8)
        @"precio5" decimal(18,8)
        @"puntoro" decimal(18,8)
        @"reqlote" bool required
        @"reqserie" bool required
        @"saldo" decimal(18,8)
        @"tipocomision" ref:"ctiposcomisionesproducto"
        @"unidad" string(10) required
        @"unidadb" string(10)
        @"unidadc" string(10)
        @"unidadd" string(10)
        @"unidade" string(10)
        @"util1" decimal(18,8)
        @"util2" decimal(18,8)
        @"util3" decimal(18,8)
        @"util4" decimal(18,8)
        @"util5" decimal(18,8)
        @"utilmin" decimal(18,8)
        @"vinculardata" bool
        @"visible" bool
        @"idepartamento" ref:"departamento"
        @"idivisa" ref:"divisa" required
        @"ilinea" ref:"linea" required
        @"imarca" ref:"marca"
        @"impuestos" ref:"cfgimpuesto" required
        @"ivariables" int
        @"proveedor1" ref:"proveedor"
        @"proveedor2" ref:"proveedor"
        @"proveedor3" ref:"proveedor"
        @"uf_solicitarcantidad" bool
        @"uf_sys_baja" bool
        @"uf_complemento" bool
        @"precio106" decimal(18,8)
        @"precio107" decimal(18,8)
        @"precio108" decimal(18,8)
        @"precio109" decimal(18,8)
        @"precio110" decimal(18,8)
        @"precio111" decimal(18,8)
        @"precio112" decimal(18,8)
        @"precio113" decimal(18,8)
        @"precio114" decimal(18,8)
        @"precio115" decimal(18,8)
        @"precio116" decimal(18,8)
        @"precio117" decimal(18,8)
        @"precio118" decimal(18,8)
        @"precio119" decimal(18,8)
        @"precio120" decimal(18,8)
        @"util106" decimal(18,8)
        @"util107" decimal(18,8)
        @"util108" decimal(18,8)
        @"util109" decimal(18,8)
        @"util110" decimal(18,8)
        @"util111" decimal(18,8)
        @"util112" decimal(18,8)
        @"util113" decimal(18,8)
        @"util114" decimal(18,8)
        @"util115" decimal(18,8)
        @"util116" decimal(18,8)
        @"util117" decimal(18,8)
        @"util118" decimal(18,8)
        @"util119" decimal(18,8)
        @"util120" decimal(18,8)
        @"uf_codigoparaproveedor1" string(50)
        @"uf_codigoparaproveedor2" string(50)
        @"uf_codigoparaproveedor3" string(50)
        @"uf_pdv" decimal(18,8)
        @"uf_dv_diasreorden" int
        @"uf_dv_inventarioseguridaddias" int
        @"uf_gruposimilares" int
        @"uf_inhabilitado" bool
        @"uf_fechainhabilitacion" datetime
        @"uf_sat_proser" string(50) required
        @"uf_sat_uniproser" string(50) required
    }
    // Catálogo de monedas o divisas
    entity "divisa" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(30) unique required
        @"tcambio" decimal(18,8)
    }
    // Describe como se han tomado los costos provenientes de distintas entradas.
    entity "dcapa" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"costo" decimal(18,8)
        @"pkentrada" int required
        @"fk_dcardex_capas" int ref:"dcardex" ["sys_pk"] required
    }

    // Relaciones a catálogos
    entity "ctiposcategorias" : "EnumModel" {}
    entity "cformacomisionproducto" : "EnumModel" {}
    entity "cclaseproducto" : "EnumModel" {}
    entity "ctipoproducto" : "EnumModel" {}
    entity "cmetodosvaluacion" : "EnumModel" {}
    entity "ctiposcomisionesproducto" : "EnumModel" {}
    entity "cstatusseries" : "EnumModel" {}

    // Relaciones a otras tablas
    entity "compra" : "TableModel"
    {
        @"auditado" bool
        @"contabilizado" bool
        @"descuento1" decimal(18,8)
        @"descuento2" decimal(18,8)
        @"directos" decimal(18,8)
        @"documento" int ref:"cdocumentos" ["id"] required
        @"fecha" date
        @"fembarque" date
        @"fentrega" date
        @"fliquidacion" date
        @"formapago" int ref:"cformaspago" ["id"] required
        @"fultimopago" date
        @"impuesto1" decimal(18,8)
        @"impuesto2" decimal(18,8)
        @"impuesto3" decimal(18,8)
        @"impuesto4" decimal(18,8)
        @"indirectos" decimal(18,8)
        @"notas" memo
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(25) required
        @"statusadministrativo" int ref:"cstatusadministrativos" ["id"] required
        @"statusentrega" int ref:"cstatusentrega" ["id"] required
        @"statusfacturacion" int ref:"cstatusfacturacion" ["id"] required
        @"statusfinanciero" int ref:"cstatusfinancieros" ["id"] required
        @"subtotal" decimal(18,8)
        @"tipoCambio"decimal(18,8)
        @"vencimiento" date
        @"aplicadoa" int ref:"compra" ["sys_pk"]
        @"ialmacen" int ref:"almacen" ["sys_pk"] required
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        // @"imovcaja" int ref:"movcaja" ["sys_pk"]
        // @"imovchequera" int ref:"movcuenta" ["sys_pk"]
        @"iproveedor" int ref:"proveedor" ["sys_pk"] required
        @"uf_color" int
        @"uf_fechacancelacion" datetime
        @"uf_importado" bool
        @"uf_iaduana" int
        @"uf_numdocaduanero" string(200)
        @"uf_fechadocaduanero" date
    }
    entity "orden" : "TableModel"
    {
        @"auditada" bool
        @"cdirecto" decimal(18,8)
        @"cindirecto" decimal(18,8)
        @"cmanoobra" decimal(18,8)
        @"cmaquinaria" decimal(18,8)
        @"contabilizada" bool
        @"d1" decimal(18,8)
        @"d2" decimal(18,8)
        @"fecha" date
        @"fprevista" date
        @"fproduccion" date
        @"hora" datetime
        @"hprevista" datetime
        @"hproduccion" datetime
        @"importe" decimal(18,8)
        @"notas" string(4096)
        @"partida" string(32)
        @"poliza" string(32)
        @"referencia" string(50) unique
        @"status" int ref:"cstatusordenproduccion" ["id"] required
        @"tiempoproduccion" int
        @"tiemposervicio" int
        @"tipocambio" decimal(18,8)
        //@"iagente" int ref:"agente" ["sys_pk"]
        @"icconsumo" int ref:"cconsumo" ["sys_pk"] required
        @"icproduccion" int ref:"cproduccion" ["sys_pk"] required
        // @"idivisa" int ref:"divisa" ["sys_pk"]
        // @"iventa" int ref:"venta" ["sys_pk"]
    }
    entity "venta" : "TableModel"
    {
        @"auditado" bool 
        @"contabilizado" bool 
        @"descuento1" decimal(18,8) 
        @"descuento2" decimal(18,8) 
        @"dmnsmesa" string(45) 
        @"dmnsnota" string(255) 
        @"dmnspersonas" int 
        @"documento" int ref:"cdocumentos" ["id"] required
        @"domicilioentrega" string(255) 
        @"fecha" date required
        @"fembarque" date 
        @"fentrega" date 
        @"fliquidacion" date 
        @"formapago" int ref:"cformaspago" ["id"] required
        @"fultimocobro" date 
        @"importeadicional" decimal(18,8) 
        @"impuesto1" decimal(18,8) 
        @"impuesto2" decimal(18,8) 
        @"impuesto3" decimal(18,8) 
        @"impuesto4" decimal(18,8) 
        @"notas" string(32000) 
        @"partida" string(32) 
        @"pcomision" decimal(18,8) 
        @"poliza" string(32) 
        @"referencia" string(25) unique required
        // @"statusadministrativo" int ref:"cstatusadministrativos" ["id"] 
        // @"statusentrega" int ref:"cstatusentrega" ["id"] 
        // @"statusfacturacion" int ref:"cstatusfacturacion" ["id"] 
        // @"statusfinanciero" int ref:"cstatusfinancieros" ["id"] 
        @"subtotal" decimal(18,8) 
        @"tipocambio" decimal(18,8) 
        @"tipodomicilio" int 
        @"txtguia" string(150) 
        @"vencimiento" date 
        // @"aplicadoa" int ref:"venta" ["sys_pk"] 
        // @"iagente" int ref:"agente" ["sys_pk"] 
        // @"icaja" int ref:"caja" ["sys_pk"] 
        @"icconsumo" int ref:"cconsumo" ["sys_pk"] required
        @"icliente" int ref:"cliente" ["sys_pk"] required
        // @"icorte" int ref:"corte" ["sys_pk"] 
        @"idivisa" int ref:"divisa" ["sys_pk"] required
        @"ifolio" int ref:"foliosdocumentos" ["sys_pk"] required
        // @"iguia" int ref:"guia" ["sys_pk"] 
        // @"imovcaja" int ref:"movcaja" ["sys_pk"] 
        // @"iporteador" int ref:"porteador" ["sys_pk"] 
        // @"irepartidor" int ref:"repartidor" ["sys_pk"] 
        @"uf_color" int 
        @"uf_fechacfd" datetime 
        @"uf_fechacancelacion" datetime 
        @"uf_dmtipoformato" int 
        @"xmlformapago" string(255) 
        @"xmlcondicionespago" string(255) 
        @"xmlmetodopago" string(255) 
        @"xmlnumerocuentapago" string(100) 
    }
    entity "dcompra" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"costototal" decimal(18,8)
        @"descuento1" decimal(18,8)
        @"descuento2" decimal(18,8)
        @"factor" decimal(18,8)
        @"impuesto1" decimal(18,8)
        @"impuesto2" decimal(18,8)
        @"impuesto3" decimal(18,8)
        @"impuesto4" decimal(18,8)
        @"notas" string(255)
        @"precio" decimal(18,8)
        @"status" int ref:"cstatusdetallecompra" ["id"] required
        @"tipocambio" decimal(18,8)
        @"unidad" string(10) required
        @"xfacturar" decimal(18,8)
        @"documento" int ref:"compra" ["sys_pk"]
        @"iproducto" int ref:"producto" ["sys_pk"] required
        @"fk_compra_detalle" int ref:"compra" ["sys_pk"] required
    }
    entity "dventa" : "TableModel"
    {
        @"cantidad" decimal(18,8)
        @"descuento1" decimal(18,8)
        @"descuento2" decimal(18,8)
        @"factor" decimal(18,8)
        @"impuesto1" decimal(18,8)
        @"impuesto2" decimal(18,8)
        @"impuesto3" decimal(18,8)
        @"impuesto4" decimal(18,8)
        @"notas" string(255)
        @"precio" decimal(18,8)
        @"status" int ref:"cstatusdetalleventa" ["id"] required
        @"tipocambio" decimal(18,8)
        @"unidad" string(10)
        @"xfacturar" decimal(18,8)
        @"xsalir" decimal(18,8)
        //@"documento" int ref:"venta" ["sys_pk"]
        @"ialmacen" int ref:"almacen" ["sys_pk"] required
        @"iproducto" int ref:"producto" ["sys_pk"] required
        @"fk_venta_detalle" int ref:"venta" ["sys_pk"] required
    }
    entity "domicilio" : "TableModel"
    {
        @"codpos" string(10)
        @"colonia" string(150)
        @"direccion" string(1024)
        @"notas" string(150)
        @"telefonos" string(150)
        //@"iciudad" int ref:"ciudad" ["sys_pk"]
        @"numint" string(1024)
        @"numext" string(1024)
    }
    entity "departamento" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
    }
    entity "linea" : "TableModel"
    {
        @"clase" int ref:"cclaseproducto" ["id"] required
        @"codigo" string(15) unique required
        @"color" int
        @"comision1" decimal(18,8)
        @"comision2" decimal(18,8)
        @"comision3" decimal(18,8)
        @"comision4" decimal(18,8)
        @"comision5" decimal(18,8)
        @"descripcion" string(50) unique required
        @"notas" string(4096)
        @"visible" bool
        @"uf_indicaciones" string(4096)
    }
    entity "marca" : "TableModel"
    {
        @"codigo" string(5) unique required
        @"descripcion" string(50) unique required
    }
    entity "cfgimpuesto" : "TableModel"
    {
        @"i1compra" string(4096)
        @"i1venta" string(4096)
        @"i2compra" string(4096)
        @"i2venta" string(4096)
        @"i3compra" string(4096)
        @"i3venta" string(4096)
        @"i4compra" string(4096)
        @"i4venta" string(4096)
        @"nombre" string(25) unique required
        @"uf_tipoi1" string(25)
        @"uf_tipoi2" string(25)
        @"uf_tipoi3" string(25)
        @"uf_tipoi4" string(25)
        @"tasa" bool
        @"objetoimp" string(2)
    }
    entity "proveedor" : "TableModel"
    {
        @"codcuenta" string(50) unique 
        @"codigo" string(35) unique required
        @"curp" string(35) unique 
        @"diascredito" int 
        @"diasentrega" int 
        @"email" string(50) 
        @"fax" string(50) 
        @"limitecredito" decimal(18,8) 
        @"nombre" string(150) unique required
        @"notas" string(32000) 
        @"rfc" string(15) 
        @"saldo" decimal(18,8) 
        //@"status" int ref:"cstatusorg" ["id"] 
        @"tasaiva" int ref:"ctasasiva" ["id"] required
        @"telefonos" string(50) 
        @"website" string(150) 
        // @"contacto1" int ref:"contacto" ["sys_pk"] 
