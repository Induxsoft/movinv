#include "dkli.dkh"
/*
    Funciones relevantes del módulo
    ---------------------------------------------------------
    Las funciones iniciaran una transacción si no hay una
    iniciada, ninguna retorna ningún valor relevante.

    Si algo sale mal, se desencadenará una excepción.

    El status de los números de serie debe ser gestionado por
    capas superiores de código, estas funciones no lo afectarán.
    ---------------------------------------------------------

    erp.inventario.aplicar_mov(db,mov_sys_pk,valuar)
        Aplica un movimiento de inventario (cardex) y realiza 
        la valuación si se indica (tratándose de salidas)

    erp.inventario.valuar_mov(db, mov_sys_pk)
        Valúa un movimiento de salida de inventario (cardex)
        que no fue valuado al ser aplicado
    
    erp.inventario.desaplicar_mov(db, mov_sys_pk)
        Desaplica un movimiento de inventario (cardex),
        incluyendo el reverso de los saldos y valuación.

    *********************************************************
    Variables de configuración global

    // Claves de la tabla cmetodovaluacion
    @inventario_mval_peps=1
    @inventario_mval_ueps=2
    @inventario_mval_prom=3
    @inventario_mval_iden=4
    @inventario_mval_ning=99

    @inventario_divisa_decs=4 //Representa la cantidad de decimales a redondear los importes
*/

#!
module ":erp.inventario"
{
    @inventario_mval_peps=1
    @inventario_mval_ueps=2
    @inventario_mval_prom=3
    @inventario_mval_iden=4
    @inventario_mval_ning=99

    @inventario_divisa_decs=4
    
    /*
    Función: desaplicar_mov(db, mov_sys_pk)
    Desaplica un movimiento de inventario (cardex)
     - db. Referencia a la base de datos
     - mov_sys_pk. Clave primaria de una fila en 'cardex' que representa un movimiento de inventario
    */
    desaplicar_mov::&db, mov_sys_pk
    {
        namespace "erp.inventario"

        start_transaction=@false

        new p { @"mov_sys_pk": mov_sys_pk }
        
        ref detalle=dbr.list(db,"select c.fecha fecha_mov, dc.*, p.reqlote, p.reqserie,p.metodovaluacion from dcardex dc inner join producto p on p.sys_pk=dc.iproducto inner join cardex c on dc.fk_cardex_movimientos=c.sys_pk where ifnull(c.aplicado,0) and dc.fk_cardex_movimientos=@mov_sys_pk",p)

        if @count(detalle)<1 { do rise_error(0,"No se puede encontrar el movimiento")}

        if not(dbr.in_transaction(db)) 
        { 
            do dbr.begin(db) 
            start_transaction=@true
        }

        for i=0;i<@count(detalle)
        {
            ref dcardex=@item(detalle,i)
            p<"dcardex_pk">:@@(dcardex,"#sys_pk")
            p<"fecha_mov*">:@@(dcardex,"&fechamov")
            p<"ialmacen">:@@(dcardex,"#ialmacen")
            p<"iproducto">:@@(dcardex,"#iproducto")

            if @@(dcardex,"#entradas")>0
            {
                if not(isnull(dbr.rec(db,"select pkentrada from dcapa where pkentrada=@dcardex_pk limit 1",p)))
                {
                    do rise_error(0,"No se puede desaplicar la entrada porque hay capas de valuación de movimientos de salida")
                }
                if not(isnull(dbr.rec(db,"select d.sys_pk from dcardex d inner 
                                            join cardex c on d.fk_cardex_movimientos=c.sys_pk
                                            where c.fecha>@fechamov and d.valuado and salidas>0 order by c.fecha desc limit 1",p)))
                {
                    do rise_error(0,"Hay salidas valuadas posteriores a esta entrada, desaplique primero las salidas valuadas")
                }

                do afectar_existencia(db,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#entradas")*-1,@@(dcardex,"#cargos")*-1)
                if @@(dcardex,"#reqlote"){
                    do lotes.afectar_existencia(db,@@(dcardex,"#ilote"),@@(dcardex,"#ialmacen"),@@(dcardex,"#entradas")*-1) }

                do dbr.execute(db,"update dcardex set valuado=0, resto=entradas where sys_pk=@dcardex_pk",p)
            }
            else if @@(dcardex,"#salidas")>0
            {
                do dbr.execute(db, "delete from dcapa where fk_dcardex_capas=@dcardex_pk",p)
                p<"abonos">:0
                if @@(dcardex,"#valuado") { p<"abonos">:@@(dcardex,"#abonos") }
                do afectar_existencia(db,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#salidas"),@@(p,"#abonos"))
                if @@(dcardex,"#reqlote"){
                    do lotes.afectar_existencia(db,@@(dcardex,"#ilote"),@@(dcardex,"#ialmacen"),@@(dcardex,"#salidas")) }

                do dbr.execute(db,"update dcardex set valuado=0, resto=entradas where sys_pk=@dcardex_pk",p)
            }
        }

        do dbr.execute(db,"update cardex set valuado=false,aplicado=false where sys_pk=@mov_sys_pk",p)
        if start_transaction { do dbr.commit(db) }
        
        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    /*
    Función: valuar_mov(db, mov_sys_pk)
    Valúa un movimiento de salida de inventario (cardex)
     - db. Referencia a la base de datos
     - mov_sys_pk. Clave primaria de una fila en 'cardex' que representa un movimiento de inventario
    */
    valuar_mov::&db, mov_sys_pk
    {

        namespace "erp.inventario"

        start_transaction=@false

        new p { @"mov_sys_pk": mov_sys_pk }
        
        ref detalle=dbr.list(db,"select dc.*, p.reqlote, p.reqserie,p.metodovaluacion from dcardex dc inner join producto p on p.sys_pk=dc.iproducto inner join cardex c on dc.fk_cardex_movimientos=c.sys_pk where dc.salidas>0 and not ifnull(dc.valuado,0) and ifnull(c.aplicado,0) and dc.fk_cardex_movimientos=@mov_sys_pk",p)

        if @count(detalle)<1 { do rise_error(0,"No se puede encontrar el movimiento o ya ha sido valuado")}

        if not(dbr.in_transaction(db)) 
        { 
            do dbr.begin(db) 
            start_transaction=@true
        }

        for i=0;i<@count(detalle)
        {
            ref dcardex=@item(detalle,i)
            using p
            {
                @"divisa_decs":@inventario_divisa_decs
                @"costo_promedio":0
                @"abonos":0
                @"dcardex_pk":@@(dcardex,"#sys_pk")
            }

            do calc_costo_salida(db,dcardex,p)
            
            if @@(p,"#abonos")>0
            {
                do dbr.execute(db,"update dcardex 
                    set cpromedio=@abonos/salidas, 
                        abonos=@abonos, 
                        valuado=true 
                    where sys_pk=@dcardex_pk",p)

                do afectar_existencia(db,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), 0,@@(p,"#abonos")*-1)
            }
        }

        do dbr.execute(db,"update cardex set valuado=true where sys_pk=@mov_sys_pk",p)
        if start_transaction { do dbr.commit(db) }
        
        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    /*
    Función: aplicar_mov(db,mov_sys_pk,valuar)
    Aplica un movimiento de inventario (cardex)
     - db. Referencia a la base de datos
     - mov_sys_pk. Clave primaria de una fila en 'cardex' que representa un movimiento de inventario
     - valuar. Valor booleano (@true) que indica si tratándose de una salida, 
     se realizará la valuación conforme al método correspondiente.
    */

    aplicar_mov::&db,mov_sys_pk, valuar
    {
        namespace "erp.inventario"

        start_transaction=@false

        new p { @"mov_sys_pk": mov_sys_pk }
        ref cardex=dbr.rec(db,"select * from cardex where sys_pk=@mov_sys_pk and not ifnull(aplicado,0);",p)
        if isnull(cardex) { do rise_error(0,"El movimiento no existe o ya ha sido aplicado")}
        ref detalle=dbr.list(db,"select dc.*, p.reqlote, p.reqserie,p.metodovaluacion from dcardex dc inner join producto p on p.sys_pk=dc.iproducto where dc.fk_cardex_movimientos=@mov_sys_pk",p)

        if not(dbr.in_transaction(db)) 
        { 
            do dbr.begin(db) 
            start_transaction=@true
        }

        for i=0;i<@count(detalle)
        {
            ref dcardex=@item(detalle,i)

            using p
            {
                @"divisa_decs":@inventario_divisa_decs
                @"dcardex_pk": @@(dcardex,"#sys_pk")
            }

            if @@(dcardex,"#ilote")<1 && @@(dcardex,"#reqlote") { do rise_error(0,"No se ha indicado el lote requerido") }
            if @@(dcardex,"#reqserie") && (@@(dcardex,"#entradas") + @@(dcardex,"#salidas")) != 1  { do rise_error(0,"El movimiento no corresponde con los números de serie indicados") }
            if @@(dcardex,"#iserie")<1 && @@(dcardex,"#reqserie") { do rise_error(0,"No se ha indicado el número de serie requerido") }
            
            if @@(dcardex,"#entradas")>0
            {
                //Es una entrada
                do dbr.execute(db,"update dcardex set resto=entradas,valuado=true where sys_pk=@dcardex_pk",p)
                do afectar_existencia(db,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#entradas"),@@(dcardex,"#cargos"))
                if @@(dcardex,"#reqlote"){
                    do lotes.afectar_existencia(db,@@(dcardex,"#ilote"),@@(dcardex,"#ialmacen"),@@(dcardex,"#entradas")) }
                
            }
            else if @@(dcardex,"#salidas")>0
            {
                using p
                {
                    @"abonos":0
                    @"costo_promedio":0
                }

                //Es una salida
                if (valuar)
                {
                    do calc_costo_salida(db,dcardex,p)

                    if @@(p,"#abonos")>0{
                        do dbr.execute(db,"update dcardex set cpromedio=@abonos/salidas, abonos=@abonos, valuado=true where sys_pk=@dcardex_pk",p)
                    }
                }
                
                do afectar_existencia(db,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#salidas")*-1,@@(p,"#abonos")*-1)
                if @@(dcardex,"#reqlote"){
                    do lotes.afectar_existencia(db,@@(dcardex,"#ilote"),@@(dcardex,"#ialmacen"),@@(dcardex,"#salidas")*-1) }
            }
        }

        using p
        {
            @"aplicado":@true
            @"valuado":valuar
        }

        do dbr.execute(db,"update cardex set aplicado=@aplicado, valuado=@valuado where sys_pk=@mov_sys_pk",p)

        if start_transaction { do dbr.commit(db) }
        
        exception
        {
            if dbr.in_transaction(db) { do dbr.rollback(db) }
            do rise_error(last_error_code(),last_error())
        }
    }

    calc_costo_promedio::&db,producto
    {
        new p{ @"producto":producto }
        sql="select sum(ifnull(cargos,0)-ifnull(abonos,0)) saldo, sum(ifnull(entradas,0)-ifnull(salidas,0)) exis from dcardex where (ifnull(valuado,0) or entradas>0) and iproducto=@producto"
        ref r=dbr.rec(db,sql,p)
        if isnull(r){ return 0 }
        if not(@@(r,"#exis")) { do rise_error(0,"No hay existencias para calcular el costo promedio")}
        return round( @@(r,"#saldo")/@@(r,"#exis") , @inventario_divisa_decs )
    }

    prepara_capa::pksalida, pkentrada, cantidad, costo
    {
        new data
        {
            @"sys_guid":uuid()
            @"sys_dtcreated*":dbr.sql("now()")
            @"sys_timestamp*":dbr.sql("now()")
            @"sys_recver":0
            @"pkentrada":pkentrada
            @"fk_dcardex_capas":pksalida
            @"cantidad":cantidad
            @"costo":costo
        }
        return data
    }

    obt_capas::&db,pk,m_costeo,producto,almacen,salidas
    {
        new p
        {
            @"producto":producto
            @"almacen":almacen
            @"salidas":salidas
            @"decs":@inventario_divisa_decs
            @"pk":pk
        }

        sql="select d.sys_pk, ifnull(d.resto,0) resto,round(cargos/entradas,@decs) costo from dcardex d inner join cardex c on d.fk_cardex_movimientos=c.sys_pk
            where ialmacen=@almacen and iproducto=@producto and ifnull(resto,0)>0 and entradas>0 and ifnull(c.aplicado,0)
            order by c.fecha"+ifstr(m_costeo==@inventario_mval_ueps," desc","")+", c.sys_pk"+ifstr(m_costeo==@inventario_mval_ueps," desc","")
        
        ref l=dbr.list(db,sql,p)
        xasignar=salidas
        costo_total=0
        for i=0;i<@count(l)
        {
            ref rw=@item(l,i)
            if @@(rw,"#resto")<xasignar
            {
                if not( dbr.execute(db,"update dcardex set resto=0 where sys_pk=@sys_pk and resto>0",rw) ){do rise_error(0,"No se pudo establecer la disminución de la entrada (resto) por la capa")}
                do dbr.insert(db,"dcapa",prepara_capa(pk,@@(rw,"#sys_pk"),@@(rw,"#resto"),@@(rw,"#costo") ))                
                costo_total=costo_total+@@(rw,"#resto") * @@(rw,"#costo")
                xasignar=xasignar-@@(rw,"#resto")
            }
            else
            {
                p<"xasignar">:xasignar
                if not( dbr.execute(db,"update dcardex set resto=resto-@xasignar where sys_pk=@sys_pk and resto>0",rw) ){do rise_error(0,"No se pudo establecer la disminución de la entrada (resto) por la capa")}
                do dbr.insert(db,"dcapa",prepara_capa(pk,@@(rw,"#sys_pk"),xasignar,@@(rw,"#costo") ))                
                costo_total=costo_total+xasignar * @@(rw,"#costo")
                xasignar=0
            }
            if xasignar==0 { break }
        }
        if xasignar>0 {do rise_error(0,"No fue posible obtener el costo de la salida por falta de existencias.")}
        return round(costo_total,@inventario_divisa_decs)
    }

    /* Calcula el costo de una salida (valuación) */
    calc_costo_salida::&db,&dcardex,&p
    {
        if @@(dcardex,"#reqserie") { dcardex<"metodovaluacion">:@inventario_mval_iden }
        if @@(dcardex,"#metodovaluacion")==@inventario_mval_iden && not(@@(dcardex,"#reqserie")) { do rise_error(0,"No se puede valuar con un método identificado a productos que no tienen número de serie")}

        switch @@(dcardex,"#metodovaluacion")
        {
            case @inventario_mval_peps
            {
                p<"abonos">:obt_capas(db,@@(dcardex,"#sys_pk"),@inventario_mval_peps,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#salidas"))
            }
            case @inventario_mval_ueps
            {
                p<"abonos">:obt_capas(db,@@(dcardex,"#sys_pk"),@inventario_mval_ueps,@@(dcardex,"#iproducto"),@@(dcardex,"#ialmacen"), @@(dcardex,"#salidas"))
            }
            case @inventario_mval_iden
            {
                p<"iserie">:@@(dcardex,"#iserie")
                ref en_ns=dbr.rec(db,"select cargos from dcardex where entradas=1 and iserie=@iserie and valuado order by sys_pk desc limit 1;",p)
                if isnull(en_ns){ do rise_error(0,"No se pudo identificar la entrada del número de serie")}
                
                using p
                {
                    @"abonos":@@(en_ns,"#cargos")
                }
            }
            default // Si no es ninguno de los métodos anteriores, asumir el costo promedio
            {
                using p
                {
                    @"costo_promedio":calc_costo_promedio(db,@@(dcardex,"#iproducto"))
                    @"abonos":round(@@(p,"#costo_promedio") * @@(dcardex,"#salidas"),@inventario_divisa_decs)
                }
            }
        }
    }

    /*
    Afecta la existencia de un producto en un almacen
     - db. Referencia a la base de datos
     - producto. Clave primaria del producto
     - almacen. Clave primaria del almacén
     - cantidad. Cantidad a incrementar (positivo) o decrementar (negativo)
     - importe. Importe a incrementar (positivo) o decrementar (negativo) del saldo
    */
    afectar_existencia::&db,producto,almacen, cantidad, importe
    {
        new p
        {
            @"producto":producto
            @"almacen":almacen
            @"cantidad":cantidad
            @"importe":importe
        }

        affected=dbr.execute(db,"update existencias 
                                        set sys_timestamp=now(),
                                        existencia=existencia+@cantidad,
                                        saldo=saldo+@importe
                                        where ialmacen=@almacen and fk_producto_iexistencias=@producto",p)
        if not(affected)                                        
        {
            new exist
            {
                @"sys_dtcreated*":dbr.sql("now()")
                @"sys_timestamp*":dbr.sql("now()")
                @"sys_guid":uuid()
                @"sys_recver":0
                @"existencia":cantidad
                @"saldo":importe
                @"ialmacen":almacen
                @"fk_producto_iexistencias":producto
            }

            do dbr.insert(db,"existencias",exist)
        }

        affected= dbr.execute(db,"update producto set existencia=existencia+@cantidad, saldo=saldo+@importe where sys_pk=@producto;",p)

        if not(affected)
        {
            do rise_error(0,"No se pudo afectar la existencia o saldo global del producto")
        }
        
    }

    module ":erp.inventario.lotes"
    {
        afectar_existencia::&db,lote,almacen,cantidad
        {
            new p
            {
                @"lote":lote
                @"almacen":almacen
                @"cantidad":cantidad
                //@"importe":importe
            }

            affected=dbr.execute(db,"update clotexalmacen 
                                            set sys_timestamp=now(),
                                            cantidad=cantidad+@cantidad
                                            where ialmacen=@almacen and fk_lote_exisxalmacen=@lote",p)

            if not(affected) { do rise_error(0,"No se pudo afectar la existencia de lotes por almacén")}
        }
    }
    
}