#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.dkl"
    #include "../config.dk"

    do @context.begin(@crud_context)

    ref movs = @("&./")
    ref db = @("&database")
    ref @http_context = @("&http")
    ref get = @@(@http_context, "&request/get")
    almc = ifstr(@@(get,"$almc")=="","-1",@@(get,"$almc"))

    function get_almacenes(&db)
    {
        new all_almc
        {
            @"sys_pk": -1
            @"almacen": "Todos"
        }
        ref almacenes = list.create()
        do list.add(almacenes, all_almc)
        ref all = dbr.list(db, "select sys_pk, descripcion almacen FROM almacen;", @null)
        for i = 0; i < list.count(all) { do list.add(almacenes, list.obj(all,i)) }
        return almacenes
    }

    new def_almacenes
    {
        @"datatable*": get_almacenes(db)
        member "attributes"
        {
            @"name": "almc"
            @"class": "induxsoft-form-select"
        }
        @"text_field": "almacen"
        @"value_field": "sys_pk"
        @"selected": almc
    }

    #$ div(class="container")
    {
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Cardex"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" title="Refrescar"){$"#<@@(@icons,'ICON_ARROW_CLOCKWISE')>"}
                a(class="btn btn-sm border-secondary induxsoft-corners btn-main-action" href="#<@INVENTARIO>") {$'#<@@(@icons,"X")>'}
            }
        }
        div(id="work_area" class="container-section mt-3")
        {
            div(class="d-flex align-items-center flex-wrap")
            {
                div(class="d-flex gap-2 align-items-center")
                {
                    small{$"Almacen:"}
                    #! do uie.dbSelect(def_almacenes)
                }
                #$ div(class="flex-grow-1 d-flex align-items-center")
                {
                    div
                    {
                        select(class="induxsoft-form-select" name="year")
                        {
                            option(value="2024"){$"2024"}
                        }
                    }
                    div(class="flex-grow-1")
                    {
                        $"Meses"
                    }
                }
            }
            div(style="max-height: 50vh; display: flex;")
            {
                "edit-table"(id="et_movimientos_producto" style="width: 100%;" data='#<to.json(movs)>')
                {
                    "edit-thead"
                    {
                        "edit-tr"
                        {
                            "edit-th"(type="NoEditable" field="fecha"){$"Fecha"}
                            "edit-th"(type="NoEditable" field="categoria"){$"Categoría"}
                            "edit-th"(type="NoEditable" field="referencia"){$"Referencia"}
                            "edit-th"(type="NoEditable" field="entradas"){$"Entradas"}
                            "edit-th"(type="NoEditable" field="salidas"){$"Salidas"}
                            "edit-th"(type="NoEditable" field="tipocambio"){$"Tipo cambio"}
                        }
                    }
                }
            }
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }
    }
}