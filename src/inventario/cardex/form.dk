#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "uielements.dkl"
    #include "../config.dk"
    #include "../_lib/lib.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)

    ref movs = @("&./")
    ref @db = @("&database")
    ref @http_context = @("&http")
    ref get = @@(@http_context, "&request/get")
    @almc = ifstr(@@(get,"$almc")=="","-1",@@(get,"$almc"))

    do scape_special_charactes(movs,"referencia")

    get_almacenes::
    {
        new all_almc
        {
            @"sys_pk": -1
            @"almacen": "Todos"
        }
        ref almacenes = list.create()
        do list.add(almacenes, all_almc)
        ref all = dbr.list(@db, "select sys_pk, descripcion almacen FROM almacen;", @null)
        for i = 0; i < list.count(all) { do list.add(almacenes, list.obj(all,i)) }
        return almacenes
    }

    print_almacenes::
    {
        new def_almacenes
        {
            @"datatable*": get_almacenes()
            member "attributes"
            {
                @"name": "almc"
                @"class": "form-select form-select-sm induxsoft-corners"
            }
            @"text_field": "almacen"
            @"value_field": "sys_pk"
            @"selected": @almc
        }

        #$ div(class="d-flex gap-2 align-items-center" style="margin-top: -3px; margin-right: 3px;")
        {
            small{$"Almacen:"}
            #! do uie.dbSelect(def_almacenes)
        }
    }

    point @filter_almacen to print_almacenes

    #$ div(class="container")
    {
        div(id="main_bar" class="row container-section my-2 mb-1 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Cardex"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ICON_ARROW_CLOCKWISE')>"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@@(@icons,'PRINTER')>"}
                a(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" href="#<@INVENTARIO>") {$'#<@@(@icons,"X")>'}
            }
        }
        div(id="work_area" class="container-section mt-1")
        {
            #! do print_date_filter(get, @filter_almacen, @null)

            #$ form(action="./" method="GET" id="form_search" class="d-flex mb-3 no-print")
            {
                input(class="induxsoft-form-control flex-grow-1" type="text" name="s" placeholder="Buscar por referencia" id="input_search" value='#<@@(get,"$s")>')
                button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center") {
                    $"Buscar"
                    $"#<@@(@icons,'ICON_SEARCH')>"
                }
            }
            div
            {
                #! lenght = list.count(movs)
                if lenght <= 0
                {
                    message = ""
                    if @@(@crud_context,"$parameters/s") == "" { message = "Sin registros." }
                    else  { message = "Sin resultados." }

                    #$ div(class="text-center") {
                        h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                    }
                }
                #! else 
                {
                    #$ div(style="overflow-y:auto;max-height: 70vh;" class="mb-2" id="list_table_container")
                    {
                        table(class="table")
                        {
                            thead
                            {
                                tr
                                {
                                    th(class="h6"){$"Fecha"}
                                    th(class="h6"){$"Categoría"}
                                    th(class="h6"){$"Referencia"}
                                    th(class="h6"){$"Entradas"}
                                    th(class="h6"){$"Salidas"}
                                    th(class="h6"){$"Tipo cambio"}
                                }
                            }
                            tbody
                            {
                                $""
                                #! for i = 0; i < list.count(movs) {
                                    ref mov = list.obj(movs, i)
                                    #$ tr
                                    {
                                        td{$"#<@@(mov,'$fecha')>"}
                                        td{$"#<@@(mov,'$categoria')>"}
                                        td{$"#<@@(mov,'$referencia')>"}
                                        td{$"#<trun(@@(mov,'#entradas'))>"}
                                        td{$"#<trun(@@(mov,'#salidas'))>"}
                                        td{$"#<@@(mov,'$tipocambio')>"}
                                    }
                                } 
                            }
                        }
                    }
                    #! a1 = ftext("Mostrando los primeros #<lenght> documentos ordenados por fecha.")
                    #$ small(class="text-secondary"){$"#<a1>"}
                }
            }
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }
    }
}