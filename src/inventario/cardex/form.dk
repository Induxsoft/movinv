#include "dkli.dkh"
#!
module "form.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "../config.dk"
    #include "../_lib/lib.dk"
    #include "../_lib/scape_special_charactes2.dk"
    #include "uielements.v12.dkl"

    do @context.begin(@crud_context)

    ref @db = @("&database")
    ref @http_context = @("&http")
    ref get = @@(@http_context, "&request/get")
    ref producto = ifnull(@("&./prod"),record.create())
    ref movs = ifnull(@("&./movs"),list.create())
    ref ttl_movs = ifnull(@("&./tmov"),record.create())

    @almc = ifstr(@@(get,"$almc")=="","-1",@@(get,"$almc"))

    get<"filter-mode">: ifstr(trim(@@(get,"filter-mode"))!="", @@(get,"filter-mode"), "month")
    get<"year">: ifstr(trim(@@(get,"year"))!="", @@(get,"year"), str(ndatetime.year(ndatetime.now())))
    get<"month">: ifstr(trim(@@(get,"month"))!="", @@(get,"month"), str(ndatetime.month(ndatetime.now())))

    do scape_special_charactes(movs,"referencia")
    do scape_special_charactes(@('&./cats'),"const")

    new def_category
    {
        @"datatable*": @('&./cats')
        @"id": "fil_categoria"
        member "attributes"
        {
            @"name": "cat"
            @"class": "induxsoft-form-select"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"text_field": "const"
        @"value_field": "id"
        @"selected": field.dstr(get, "cat", "-1")
    }
    new def_almacenes
    {
        @"datatable*": @('&./almc')
        @"id": "fil_almacen"
        member "attributes"
        {
            @"name": "almc"
            @"class": "induxsoft-form-select"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"text_field": "const"
        @"value_field": "id"
        @"selected": field.dstr(get, "almc", "-1")
    }

    new table_definition
    {
        @"datatable*": movs
        @"leyend": "Mostrando los primeros # documentos ordenados por fecha"
        member @"columns"
        {
            member @"dalmacen" { @"caption":"Almacén" }
            member @"fecha"
            {
                @"caption":"Fecha"
                @"align": "center"
            }
            member @"categoria" { @"caption":"Categoría" }
            member @"referencia" { @"caption":"Referencia" }
            member @"entradas"
            {
                @"caption":"Entradas"
                @"align": "center"
            }
            member @"salidas"
            {
                @"caption":"Salidas"
                @"align": "center"
            }
            member @"cargos"
            {
                @"caption":"Cargos"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 4
            }
            member @"abonos"
            {
                @"caption":"Abonos"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 4
            }
            member @"tipocambio"
            {
                @"caption":"T. C"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 6
            }
            member @"descripcion" { @"caption":"Descripción" }
        }
    }

    if @("#parameters/almc") > 0 { do field.remove(table_definition,"columns/dalmacen") }

    new nav_config
    {
        @"title": cut("Cardex - "+@@(producto,"$cproducto"),50)
        @"buttons*": @null
        @"urlexit": @INVENTARIO
    }
    
     ref list_years = list_years(11,0)
    fdr_year_opt = ""
    for i = 0; i < list.count(list_years) { fdr_year_opt = fdr_year_opt + list.str(list_years,i) + "," }
    fdr_year_opt = rremove(fdr_year_opt,1)

    #$ div(class="container-fluid p-0")
    {
        #! do uie.printV12FormBar(nav_config)

        #$ div(id="work_area" class="container-section p-2 pt-0")
        {
            div(class="show-on-print"){
            div(class="row")
            {
                div(class="col-3 text-start")
                {
                    small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                    small(class="d-block"){ b{$"Impresión: "} $"#<date_str(now(),'dd/MMM/yyyy')>" }
                }
                div(class="col-6 text-center")
                {
                    h4(class=""){$"Cardex de producto"}
                }
                div(class="col-3 text-end")
                {
                    small(class="d-block" id="lbl_almacen"){$""}
                }
            }}

            div
            {
                div(class="d-flex justify-content-end flex-wrap gap-3 mb-1")
                {
                    span(class="flex-grow-1 fw-bold"){$"#<@@(producto,'$dproducto')> (#<@@(producto,'$cdivisa')>)"}

                    span{ small(class="fw-bold"){$"Existencia y saldo: "} $"#<format(@@(producto,'#existencia'),'#,0.0000')>" }
                    span{ small(class="fw-bold"){$""} $"#<@@(producto,'$unidad')>" }
                    span{ small(class="fw-bold"){$""} $"#<@@(producto,'$cdivisa')>" }
                    span{ small(class="fw-bold"){$""} $"#<format(@@(producto,'#saldo'),'$ #,0.0000')>" }

                    small(class="text-muted"){$"|"}

                    span{ small(class="fw-bold"){$"Entradas: "} $"#<format(@@(ttl_movs,'#entradas'),'#,0.0000')>" }
                    span{ small(class="fw-bold"){$"Salidas: "} $"#<format(@@(ttl_movs,'#salidas'),'#,0.0000')>" }
                    span{ small(class="fw-bold"){$"Cargos: "} $"#<format(@@(ttl_movs,'#cargos'),'$ #,0.0000')>" }
                    span{ small(class="fw-bold"){$"Abonos: "} $"#<format(@@(ttl_movs,'#abonos'),'$ #,0.0000')>" }
                }

                div(class="#<ifstr(@('error/message')!='','alert alert-danger','')> overflow-auto"){$"#<@('error/message')>"}

                form(action="./" method="GET" id="form_filter" class="no-print mb-1")
                {
                    div(class="py-1 w-100 d-flex gap-2 align-items-center flex-wrap")
                    {
                        div(class="d-flex gap-2")
                        {
                            div{#! do uie.dbSelect(def_almacenes)} #$
                        }
                        div(class="flex-grow-1")
                        {
                            "filter-date-range"(
                                "mode-field"="filter-mode"
                                "year-field"="year"
                                "month-field"="month"
                                "range-field"="range"
                                "from-field"="datefrom"
                                "to-field"="dateto"
                                "selection"='#<to.json(get)>'
                                "lastdays-options"="15,30,45,60,90"
                                "years-options"="#<fdr_year_opt>"
                                "custom-range"="true"
                                "form"="#form_filter"
                                "auto-submit"="true"
                                "label-months"="Ver por cada mes"
                                "label-days"="Últ. @lastdays días"
                                "label-custom"="Personalizado"
                                "label-from"="Desde:"
                                "label-to"="Hasta:"
                                "month-names"="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
                            ){$""}
                        }
                    }

                    div(class="py-1 w-100 d-flex gap-2 align-items-center flex-wrap")
                    {
                        div(class="d-flex gap-2")
                        {
                            div{#! do uie.dbSelect(def_category) } #$
                        }
                        div(class="flex-grow-1")
                        {
                            #$ "filter-text"(
                                "id"="ft_search"
                                "text-field"="s"
                                "placeholder"="Buscar por referencia"
                                "form"="#form_filter"
                                "value"="#<@@(get,'$s')>"
                                "auto-submit"="true"
                                "class"="w-100"
                            ){$""}
                        }
                    }
                }
                #! do uie.dbeditable(table_definition,"table_cardex")
            }
        }
        #$ div(id="status_bar" class="container-section")
        {
            $""
        }

        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded", () => {
                const sel_almacen = document.getElementById("fil_almacen");
                const lbl_almacen = document.getElementById("lbl_almacen");

                if (Number(sel_almacen.value) > 0)
                {
                    const opt_almacen = sel_almacen.options[sel_almacen.selectedIndex];
                    lbl_almacen.textContent = opt_almacen.textContent;
                }
            });
        '}
    }
}