#include "dkli.dkh"
#!
module "model"
{
    #include "../config.dk"

    function cardex.obtenerMovimientosProducto(&db, &params)
    {
        sql_product = "
        SELECT
            p.codigo AS cproducto,
            p.descripcion AS dproducto,
            p.unidad,
            SUM(IFNULL(ex.existencia,0)) existencia,
            SUM(IFNULL(ex.saldo,0)) saldo,
            dvs.codigo AS cdivisa
		FROM producto p
            INNER JOIN divisa AS dvs ON p.idivisa = dvs.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk
		WHERE p.sys_pk = @_entity_id
            AND IF(IFNULL(@almc,'-1')='-1', TRUE, ex.ialmacen = @almc)
        "

        sql_product_movs = "
        SELECT
            alm.descripcion AS dalmacen,
            DATE_FORMAT(c.fecha, '%d/%m/%Y') fecha,
            ct.descripcion categoria,
            c.referencia,
            IFNULL(d.entradas,0) entradas,
            IFNULL(d.cargos,0) cargos,
            IFNULL(d.salidas,0) salidas,
            IFNULL(d.abonos,0) abonos,
            d.tipocambio ,
            IFNULL(c.descripcion,'') AS descripcion
        FROM dcardex d
            INNER JOIN almacen AS alm ON d.ialmacen = alm.sys_pk
            INNER JOIN cardex c ON d.fk_cardex_movimientos = c.sys_pk
            INNER JOIN categoria ct ON c.icategoria = ct.sys_pk
            INNER JOIN producto p ON d.iproducto = p.sys_pk
        WHERE p.sys_pk=@_entity_id
            AND IF(IFNULL(@s,'')='', true, c.referencia LIKE CONCAT('%',@s,'%'))
            AND IF(IFNULL(@year,'')='', true, YEAR(c.fecha)=@year)
            AND IF(IFNULL(@month,'')='', true, (YEAR(c.fecha)=IFNULL(@year,YEAR(NOW())) AND MONTH(c.fecha)=@month))
            AND IF(IFNULL(@range,'-99')='-99', true, (DATE(c.fecha) BETWEEN DATE_ADD(NOW(), INTERVAL -"+str(@@(params,"#range"))+" DAY) AND NOW()))
            AND IF(IFNULL(@datefrom,'')='' AND IFNULL(@dateto,'')='', true, (DATE(c.fecha) BETWEEN DATE(@datefrom) AND DATE(@dateto)))
            AND IF(IFNULL(@almc,'-1')='-1', true, d.ialmacen=@almc)
            AND IF(IFNULL(@cat,'-1')='-1', true, ct.sys_pk=@cat)
        ORDER BY c.fecha
        LIMIT #<@default_max_rows>
        "

        sql_total_movs = "SELECT SUM(entradas) entradas, SUM(salidas) salidas, SUM(cargos) cargos, SUM(abonos) abonos FROM (#<ftext(sql_product_movs)>) AS tbl"

        ref cats = dbr.list(db, "SELECT sys_pk id, concat(codigo, ' - ' ,descripcion) const FROM categoria WHERE tipo = 3;", @null)
        ref almc = dbr.list(db, "SELECT sys_pk id, descripcion const FROM almacen;", @null)

        new response
        {
            @"prod*": dbr.rec(db, ftext(sql_product), params)
            @"movs*": dbr.list(db, ftext(sql_product_movs), params)
            @"tmov*": dbr.rec(db, ftext(sql_total_movs), params)
            @"cats*": prepare_filter(cats)
            @"almc*": prepare_filter(almc)
        }

        return response
    }
    prepare_filter::list
    {
        new record
        {
            @"id": "-1"
            @"const": "Todos"
        }
        do list.ins(list, 0, record)
        return list
    }

    @table_name = "cardex"
}