#include "dkli.dkh"
#!
module "Caducidades"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "inventario/config.dk"

    do @context.begin(@crud_context)

    ref data = ifnull(@("&./data"),list.create())
    ref titles = ifnull(@("&./titles"),record.create())

    new fil_almacen
    {
        @"datatable*": ifnull(@("&./list_almcns"),list.create())
        @"id": "fil_almacen"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_almacen"
        }
        @"first_value": "-1"
        @"first_text": "(Todos los almacenes)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @("#parameters/fil_almacen")
    }

    new fil_clase
    {
        @"datatable*": ifnull(@("&./list_clases"),list.create())
        @"id": "fil_clase"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_clase"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las clases)"
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("#parameters/fil_clase")
    }

    new fil_linea
    {
        @"datatable*": ifnull(@("&./list_lineas"),list.create())
        @"id": "fil_linea"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_linea"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las lineas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @("#parameters/fil_linea")
    }

    new fil_marca
    {
        @"datatable*": ifnull(@("&./list_marcas"),list.create())
        @"id": "fil_marca"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_marca"
        }
        @"first_value": "-1"
        @"first_text": "(Todas las marcas)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @("#parameters/fil_marca")
    }

    new fil_depto
    {
        @"datatable*": ifnull(@("&./list_deptos"),list.create())
        @"id": "fil_depto"
        new member "attributes"
        {
            @"class": "form-select form-select-sm rounded-0"
            @"name": "fil_depto"
        }
        @"first_value": "-1"
        @"first_text": "(Todos los departamentos)"
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"selected": @("#parameters/fil_depto")
    }

    new nav_config
    {
        @"title": "Caducidades"
        @"urlexit": "javascript:window.history.back()"
    }

    #$
    div(class="container v12-list-view" id="view")
    {
        section(class="bg-white" id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$
            style
            {$'
                tr th { font-size:.9rem; outline:none; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; -o-text-overflow:ellipsis; }
                tr td { font-size:.8rem; }
            '}

            form(class="" action="./" method="GET" id="form-filter")
            {
                div(class="d-flex align-items-center gap-1 mb-1")
                {
                    div(class="d-flex gap-1")
                    {
                        div{#! do uie.dbSelect(fil_almacen) }#$
                        div{#! do uie.dbSelect(fil_clase) }#$
                        div{#! do uie.dbSelect(fil_linea) }#$
                        div{#! do uie.dbSelect(fil_marca) }#$
                        div{#! do uie.dbSelect(fil_depto) }#$
                        div{ input(class="form-control form-control-sm rounded-0" type="date" name="fil_fcorte" id="fil_fcorte" title="Fecha de corte") }
                    }
                    div(class="d-flex flex-grow-1 justify-content-end"){ button(class="btn btn-sm btn-primary rounded-0" type="submit" id="btn_filter"){$"Aplicar"} }
                }
            }
        }

        div(class="bg-light w-100 p-2" style="max-height:80vh; overflow-y:auto;") {
        div(class="" style="box-shadow: inset 0 -3em 3em rgba(0, 0, 0, 0.1), 0.3em 0.3em 1em rgba(0, 0, 0, 0.3);")
        {
            section(class="bg-white p-1" id="work_area")
            {
                p(class="text-center mb-0"){$"#<@@(titles,'$title')>"}
                p(class="text-center mb-0"){$"#<@@(titles,'$subtitle')>"}
                p(class="text-center mb-0"){$"#<@@(titles,'$subtitle_2')>"}

                div(class="row")
                {
                    div(class="col-3")
                    {
                        small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                        small(class="d-block"){ b{$"Impresión: "} $"#<date_str(now(),'dd/MMM/yyyy')>" }
                    }
                    div(class="col-6")
                    {
                        h5(class="text-center"){$"Caducidades"}
                    }
                    div(class="col-3 text-end")
                    {
                        $""
                    }
                }
                
                table(class="table table-sm table-bordered my-2")
                {
                    thead
                    {
                        tr(class="bg-light-gray")
                        {
                            th(class="text-center"){$"Fecha"}
                            th(class="text-center"){$"No. Interno"}
                            th(class="text-center"){$"Referencia"}
                            th(class="text-center"){$"Categoría"}
                            th(class="text-center"){$"Descripción"}
                            th(class="text-center"){$"Cargos"}
                            th(class="text-center"){$"Abonos"}
                            th(class="text-center"){$"Almacén"}
                        }
                    }
                    tbody
                    {
                        #!
                        for i = 0; i < list.count(data); i+1
                        {
                            ref obj = list.obj(data,i)
                            numfmt = "$ #,0.00"
                            
                            #$
                            tr
                            {
                                td(class="text-center"){$"#<@@(obj,'$fecha')>"}
                                td(class=""){$"#<@@(obj,'$no_interno')>"}
                                td(class=""){$"#<@@(obj,'$referencia')>"}
                                td(class=""){$"#<@@(obj,'$categoria')>"}
                                td(class=""){$"#<@@(obj,'$descripcion')>"}
                                td(class="text-end"){$"#<format(@@(obj,'#cargos'),numfmt)>"}
                                td(class="text-end"){$"#<format(@@(obj,'#abonos'),numfmt)>"}
                                td(class=""){$"#<@@(obj,'$almacen')>"}
                            }
                            #!
                        }
                        #$
                    }
                }

                p(class="text-center mb-0"){$"#<@@(titles,'$footer')>"}
            }
        }}

        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded", () => {
                const fil_clase = document.getElementById("fil_clase");
                let url_get_linea = "#<@URL_OBTENER_LINEAS_XCLASE>";
                
                fil_clase.addEventListener("change", (event) => {
                    let params = {iclase:event.target.value}
                    let first_object = {sys_pk: -1, descripcion: "(Todas las lineas)"}
                    fillSelect("fil_linea","sys_pk","descripcion",url_get_linea,params,first_object);
                });

                function fillSelect(id, kf, vf, url, params={}, fo={})
                {
                    const select = document.getElementById(id);

                    let endpoint = InduxsoftCrudlModel.UrlReplace(url,params);
                    let selected = select.value ?? "";

                    fetch(endpoint).then(response => response.json())
                    .then(data => {
                        if (data.message) {
                            alert(data.message);
                            return;
                        }
                        
                        select.innerHTML = "";

                        if (Object.keys(fo).length >= 2) data.unshift(fo);

                        data.forEach(obj => {
                            const option = document.createElement("option");
                            option.value = obj[kf];
                            option.text = obj[vf];
                            if (obj[kf] === selected) option.selected = true;

                            select.appendChild(option);
                        });
                    })
                    .catch(error => console.error(error));
                }
            });
        '}
    }
    #!

    do @context.end()
}