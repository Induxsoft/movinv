#include "dkli.dkh"
#set "meta-xml-declaration" ""
#!
module ""
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "webcl.dkh"
    #include "dbr.vars.dkl"
    #include "./lib.dk"
    
    @decimals_existencia= 4
    @decimales_precio= 2
    @zimpuesto= 1

    endpoint="https://search.api.induxsoft.net/#<@inventario_id_engine>/?result=metadata&limit=#<@inventario_limit>"
    ref db=GetDb()
    ref payload=get_payload()
    ref data=@@(payload,"&data")
    ref params=params()

    //variables globales
    @clave_vector_registro=replace(trim(dbr.vars.get(db,"clave_vector_registro"))," ","")
    @precio_usar_sise=trim(dbr.vars.get(db,"precio_usar_sise"))
    @existencia_a_informar=trim(dbr.vars.get(db,"existencia_a_informar"))
    @inventario_id_engine=trim(dbr.vars.get(db,"inventario_id_engine"))
    @inventario_token_engine=trim(dbr.vars.get(db,"inventario_token_engine"))
    @inventario_limit=parse.num(dbr.vars.get(db,"inventario_limit"))
    if @inventario_id_engine == ""{do rise_error(0,"No ha configurado el ID del motor vectorial")}

    
    new h
    {
        @"Authorization":@inventario_token_engine
        @"content-type":"application/json"
    }
    
    res=http.request(ftext(endpoint),"POST",h,to.json(payload))

    ref result=from.json(res)

    cantidad_resultad=@count(result)
    list_id=""
    for i = 0; i < cantidad_resultad
    {
        ref r=@item(result,i)

        if cantidad_resultad == (i+1){list_id=list_id + "TRIM(p."+@clave_vector_registro+")='"+@@(r,'$content')+"' "}
        else{list_id=list_id + "TRIM(p."+@clave_vector_registro+")='"+@@(r,'$content')+"' OR "}
        
    }

    response="Sin información"
    if list_id !=""
    {
        new p{@"exit_a_info":@existencia_a_informar}
        template=""
        sql_group_by="GROUP BY p.sys_pk"
        
        switch @existencia_a_informar
        {
            case "@global"{break}
            case "@por_almacen"
            {
                sql_group_by="GROUP BY a.sys_pk,p.sys_pk"
                break
            }
            default
            {
                p<"almacen">:@existencia_a_informar
                break
            }
        }
        @sql_exitencia=ftext("ROUND(SUM(e.existencia),#<@decimals_existencia>)")
        sql="SELECT p.sys_pk,p.sys_guid,p.codigo,
        p.descripcion,a.descripcion almacen,p.unidad,
        #<@sql_exitencia> existencia,#<@precio_usar_sise> as _precio_use ,
        (
            CASE
                WHEN @exit_a_info = '@global' THEN TRIM(#<@sql_exitencia>)
                WHEN @exit_a_info = '@por_almacen' THEN CONCAT(a.descripcion,' : ',#<@sql_exitencia>)
                ELSE TRIM(#<@sql_exitencia>)
            END
        )str_existencia,
        (CONVERT(REPLACE(SUBSTRING_INDEX(i.i1venta, '|', #<@zimpuesto>),'%',''), DECIMAL(18,6)) / 100) AS i1_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i2venta, '|',#<@zimpuesto>),'%',''), DECIMAL(18,6)) / 100) AS i2_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i3venta, '|',#<@zimpuesto>),'%',''), DECIMAL(18,6)) / 100) AS i3_tasa,
         (CONVERT(REPLACE(SUBSTRING_INDEX(i.i4venta, '|',#<@zimpuesto>),'%',''), DECIMAL(18,6)) / 100) AS i4_tasa,
         p.desc2,p.desc3,p.desc4,p.desc5,d.codigo AS divisa
        FROM producto p
        INNER JOIN divisa d ON p.idivisa=d.sys_pk
        INNER JOIN cfgimpuesto i ON p.impuestos=i.sys_pk
        INNER JOIN existencias e ON p.sys_pk=e.fk_producto_iexistencias
        INNER JOIN almacen a ON e.ialmacen=a.sys_pk
        WHERE ("+list_id+")
        AND (IFNULL(@almacen,'')='' OR a.codigo=@almacen)
        "+sql_group_by+"
        "

        ref productos=dbr.list(db,ftext(sql),p)
        
        for i = 0; i < @count(productos)
        {
            ref prod=@item(productos,i)
            
            @codigo=@@(prod,"$codigo")
            @descripcion=@@(prod,"$descripcion")
            @unidad=@@(prod,"$unidad")
            @almacen=@@(prod,"$almacen")
            @existencia=round(@@(prod,"#existencia"),@decimals_existencia)
            @divisa=@@(prod,"$divisa")

            @str_existencia=@@(prod,"$str_existencia")
            //cacular impuestos
            descuentos=@@(prod,"#desc2") + @@(prod,"#desc3") + @@(prod,"#desc4")+ @@(prod,"#desc5")
            sub_desc = (@@(prod,"#_precio_use") - descuentos)
            i1_tasa = @@(prod,"#i1_tasa")
            i2_tasa = @@(prod,"#i2_tasa")
            i3_tasa = @@(prod,"#i3_tasa")
            i4_tasa = @@(prod,"#i4_tasa")
            
            impuesto1 = (sub_desc * i1_tasa)
            impuesto2 = (sub_desc * i2_tasa)

            i1_i2 = (impuesto1 + impuesto2)
            sub_desc_i1_i2 = (sub_desc + i1_i2)
            impuesto3 = (sub_desc_i1_i2 * i3_tasa)
            impuesto4 = (sub_desc_i1_i2 * i4_tasa)
        
        
            i3_i4 = (impuesto3 + impuesto4)
            impuestos = (i1_i2 + i3_i4)
            precio = (sub_desc + impuestos)

            @precio=round(precio,@decimales_precio)
            if i == 0 && field.exist(p,"almacen")
            {
                template=template + " Almacén: "+@almacen+ "\n---\n"
            }

            template=template + "Código (sku): #<@codigo>\n"
            template=template + "Producto: #<@descripcion>\n"
            template=template + "Unidad: #<@unidad>\n"
            template=template + "Existencia: #<@str_existencia>\n"
            template=template + "Precio unitario: #<@precio> #<@divisa> \n---\n"
            template=ftext(template)
        }
        if template != ""{response=template}
    }
    

    do responseText(response)

    exception
    {
        do responseText(last_error())
    }
}