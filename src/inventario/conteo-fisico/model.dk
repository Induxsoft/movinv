#include "dkli.dkh"
#!
module ":conteo"
{
    ref lib_csv = _import_library("devkron.serialize.csv.dll")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvRead","CsvRead","System.String,System.String","*")
    do _map_function(lib_csv,"devkron.serialize.csv.csvHelper","CsvWrite","CsvWrite","System.String,*System.Object","void")

    #include "../movimientos.dkh"
    
    @default_max_rows= 500
    @table_name="cfconteo"

    @list_query="
    SELECT distinct
        c.sys_pk,
		c.sys_dtcreated,
        c.cerrado,
        DATE_FORMAT(c.conclusion,'%Y-%m-%d') conclusion,
        DATE_FORMAT(c.inicio,'%Y-%m-%d') inicio,
        c.nombre,
        c.notas,
        c.parcial,
        @sf :=ROUND(IFNULL(c.saldofisico,0),2)sf,
        @st := ROUND(IFNULL(c.saldoteorico,0),2) st,
        @sf saldofisico,
        @st saldoteorico,
        c.sincronizado
    FROM
        cfconteo c
        #<joins>
    WHERE
        NOT IFNULL(c.sys_deleted,0)
        #<conditions>
        AND IF(IFNULL(@s,'')='', TRUE, CONCAT_WS(';',c.nombre,c.notas) LIKE CONCAT('%',@s,'%'))
    ORDER BY
        c.sys_dtcreated DESC;
    "
    
    ImportExist::&db,&params
    {
        join=""
        if @@(params,"#grupo") < 1
        {
            sql="SELECT DISTINCT
                    producto.sys_pk as pk,
                    producto.reqlote as lote,
                    producto.reqserie as serie,
                    divisa.tcambio as tc
                from
                    producto
                    inner join divisa on divisa.sys_pk = producto.idivisa
                    #<join>
                where
                    producto.itipo = 2 "
        }
        else 
        {
            sql="select
                    distinct producto.sys_pk as pk,
                    producto.reqlote as lote,
                    producto.reqserie as serie,
                    divisa.tcambio as tc
                from
                    (
                        producto
                        inner join divisa on divisa.sys_pk = producto.idivisa
                    )
                    inner join grupoproductos_producto_ on producto.sys_pk = grupoproductos_producto_.iproductos
                    #<join>
                where
                    producto.itipo = 2
                    and grupoproductos_producto_.igrupos = @grupo"

        }
        switch tolower(@@(params,"$exc_prod"))
        {
            case "b"
            {
                join="INNER join existencias e on producto.sys_pk=e.fk_producto_iexistencias"
                break
            }
            case "c"
            {
                join="INNER join existencias e on producto.sys_pk=e.fk_producto_iexistencias"
                sql=sql +" AND e.ialmacen=@almacen "
                break
            }
        }

        if @@(params,"#linea")> 0{sql=sql + " AND producto.ilinea=@linea "}
        if @@(params,"#marca")> 0{sql=sql + " AND producto.imarca=@marca "}
        if @@(params,"#departamento")> 0{sql=sql + " AND producto.idepartamento=@departamento "}

        if @@(params,"#random"){sql=sql + " ORDER BY RAND() LIMIT @limit "}

        ref productos=dbr.list(db,ftext(sql),params)
        for i = 0; i < @count(productos)
        {
            ref producto=@item(productos,i)
            if not(@@(producto,"#lote")) || not(@@(producto,"#serie"))
            {
                params<"ppk">:@@(producto,"#pk")
                params<"ptc">:if(@@(producto,"#tc")> 0,@@(producto,"#tc"),1)
                do ImportProducto(db,params)
            }
        }
    }
    caculateCostoPromedio::&existencia
    {
        exist_teorico=round(@@(existencia,"#existencia"),6)
        costo_promedio= 0
        module "calc_costo_promedio"
        {
            if exist_teorico <= 0 {costo_promedio=@@(existencia,"#costoultimo")}
            else{costo_promedio=div(@@(existencia,"#saldo_teorica"),exist_teorico) }//erp.inventario.calc_costo_promedio(db,@@(params,"#ppk"))
            
            exception{costo_promedio= 0}
        }
        return costo_promedio
    }
    @__sql_existencia="select
                    almacen.sys_pk as pkalmacen,
                    existencias.existencia as existencia,
                    (ifnull(sum(ifnull(existencias.existencia,0)),0) * ifnull(producto.costopromedio,0)) as saldo,
                    ifnull(sum(ifnull(existencias.saldo,0)),0) as saldo_teorica,
                    producto.costoultimo
                from
                    almacen
                    inner join (
                        existencias
                        inner join producto on existencias.fk_producto_iexistencias = producto.sys_pk
                    ) on almacen.sys_pk = existencias.ialmacen
                where
                    existencias.fk_producto_iexistencias =@ppk
                    and existencias.ialmacen =@almacen
                LIMIT 1"
    ImportProducto::&db,&params
    {
        sql="select sys_pk from almacen where sys_pk=@almacen"
        ref almacen=dbr.rec(db,sql,params)
        if not(isnull(almacen))
        {
            sql=@__sql_existencia

            ref existencia=dbr.rec(db,sql,params)
            if not(isnull(existencia))
            {
                
                exist_teorico=round(@@(existencia,"#existencia"),6)
                costo_promedio=caculateCostoPromedio(existencia)

                new cfexist
                {
                    @"costopromedio":round(costo_promedio,2)
                    @"exist_fisico": 0
                    @"exist_teorico": exist_teorico
                    @"ialmacen":@@(params,"#almacen")
                    @"iproducto":@@(params,"#ppk")
                    @"iconteo":@@(params,"#pk_conteo")
                }

                do dbr.save(db,"cfexist",cfexist)

                params<"exist_teorico">:@@(cfexist,"#exist_teorico") * @@(cfexist,"#costopromedio")

                sql="UPDATE cfConteo SET saldoteorico=ifnull(saldoteorico,0) + @exist_teorico WHERE sys_pk=@pk_conteo"

                do dbr.execute(db,sql,params)
            }
            
        }
    }
    prepareView::&db,&params,&data
    {
        using data
        {
            @"lineas*":dbr.list(db,"select l.sys_pk,concat(l.codigo,' - ',l.descripcion)descripcion from linea l where IFNULL(l.sys_deleted,0)=0 and (clase = 1 Or clase=4 Or Clase=3 or Clase = 2) Order By descripcion",@null)
            @"departamentos*":dbr.list(db,"SELECT d.sys_pk,CONCAT(d.codigo,' - ',d.descripcion)descripcion FROM departamento d WHERE IFNULL(d.sys_deleted,0)=0",@null)
            @"marcas*":dbr.list(db,"SELECT m.sys_pk,CONCAT(m.codigo,' - ',m.descripcion)descripcion FROM marca m WHERE IFNULL(m.sys_deleted,0)=0",@null)
            @"grupos*":dbr.list(db,"Select sys_pk, nombre From grupoproductos Order By nombre",@null)
        }
    }
    read::&db,&params
    {
        ref entity= entity.read(db,params)
        do prepareView(db,params,entity)
        return entity
    }
    blank::&db,&params
    {
      new entity{}
      do prepareView(db,params,entity)
      return entity
    }
    create::&db,&params,&data
    {
        @use_transaction = @false
            do dbr.apps.action.pre("GE41")
        do dbr.begin(db)
        
            using params
            {
                @"linea":@@(data,"#sel_linea")
                @"almacen":@@(data,"#uf_almacen")
                @"departamento":@@(data,"#sel_departamento")
                @"marca":@@(data,"#sel_marca")
                @"grupo":@@(data,"#sel_grupo")
                @"random":parse.bool(@@(data,"random"))
                @"exc_prod":@@(data,"$exc_prod")
                @"exc_other_alm":parse.bool(@@(data,"exc_other_alm"))
                @"limit":if(@@(data,"#articulos")> 0,@@(data,"#articulos"),1)
            }
            data<"parcial">: 0
            if @@(data,"#sel_linea")> 0 || @@(data,"#sel_departamento") > 0 || @@(data,"#sel_marca")> 0 || @@(data,"#sel_grupo")> 0{data<"parcial">: 1}
            
            data<"inicio*">:now()
            @create_fields="cerrado,conclusion,inicio,nombre,notas,parcial,saldofisico,saldoteorico,sincronizado"

            ref almacenes=from.json(@@(data,"$uf_almacen"))

            ref entity=entity.create(db,params,data)
            params<"pk_conteo">:@@(entity,"#sys_pk")

            for i = 0; i < @count(almacenes)
            {
                ref almacen=@item(almacenes,i)
                params<"almacen">:@@(almacen,"#sys_pk")
                do ImportExist(db,params)   
            }

            do dbr.apps.action.pos(entity)
        do dbr.commit(db)
            do dbr.apps.action.ext(entity)

        return entity
        
        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    
    }

    evaluateFilters::&params
    {
        // Establecer filtros predeterminados
        if not(field.exist(params,"alm")) { params<"alm"> : -1 }
        if not(field.exist(params,"stt")) { params<"stt"> : 1 }

        curr_ndt = ndatetime.now()
        curr_year = ndatetime.year(curr_ndt)
        curr_month = ndatetime.month(curr_ndt)
        curr_day = ndatetime.day(curr_ndt)

        // fdr_init
        using params
        {
            @"fdr_field": field.dnum(params,"fdr_field",1)
            @"fdr_mode": field.dstr(params,"fdr_mode","lastdays")
            // [month]
            @"fdr_year": field.dnum(params,"fdr_year",curr_year)
            @"fdr_month": field.dnum(params,"fdr_month",curr_month)
            // [lastdays]
            @"fdr_range": field.dnum(params,"fdr_range",30)
            // [range]
            @"fdr_from": field.dstr(params,"fdr_from",date_str(now(),"yyyy-MM-01"))
            @"fdr_to": field.dstr(params,"fdr_to",date_str(now(),"yyyy-MM-dd"))
        }

        // Preparar consulta
        new date_fields
        {
            @"1": "c.inicio"
            @"2": "c.conclusion"
        }
        fdr_field = field.str(date_fields, @@(params,"#fdr_field"))
        status = @@(params,"#stt")
        joins = ""
        conditions = ""

        if @@(params,"#alm") > 0
        {
            joins = "INNER JOIN cfexist cap ON cap.iconteo = c.sys_pk"
            conditions = "AND cap.ialmacen = @alm"
        }

        if status == 1 { conditions = conditions + " AND NOT IFNULL(c.cerrado,0) AND NOT IFNULL(c.sincronizado,0)" }
        else if status == 2 { conditions = conditions + " AND IFNULL(c.cerrado,0) AND NOT IFNULL(c.sincronizado,0)" }
        else if status == 3 { conditions = conditions + " AND IFNULL(c.cerrado,0) AND IFNULL(c.sincronizado,0)" }

        conditions = conditions + "
        AND (
            CASE @fdr_mode
                WHEN 'month' THEN (YEAR(#<fdr_field>) = @fdr_year AND MONTH(#<fdr_field>) = @fdr_month)
                WHEN 'lastdays' THEN (DATE(#<fdr_field>) BETWEEN ADDDATE(DATE(NOW()), INTERVAL -@fdr_range DAY) AND DATE(NOW()))
                WHEN 'range' THEN (
                    CASE
                        WHEN @fdr_from != '' && @fdr_to != '' THEN (DATE(#<fdr_field>) BETWEEN @fdr_from AND @fdr_to)
                        WHEN @fdr_from != '' && @fdr_to = '' THEN (DATE(#<fdr_field>) >= @fdr_from)
                        WHEN @fdr_from = '' && @fdr_to != '' THEN (DATE(#<fdr_field>) <= @fdr_to)
                        ELSE TRUE
                    END
                )
                ELSE TRUE
            END
        )
        "

        // Parsear consulta
        conditions = ftext(conditions)
        @list_query = ftext(@list_query)
    }

    list::&db,&params
    {
        do dbr.apps.action.grant("GE40")

        do evaluateFilters(params)
        ref entity = entity.list(db,params)

        for i = 0; i < @count(entity)
        {
            ref item=@item(entity,i)
            
            if @@(item,"#parcial"){item<"tipo">:"Parcial"}
            else{item<"tipo">:"Completo"}

            if @@(item,"#sincronizado"){ item<"status"> : "Sincronizado" }
            else if @@(item,"#cerrado"){ item<"status"> : "Cerrado" }
            else
            {
                item<"status"> : "Abierto"
                item<"conclusion"> : "En proceso"
            }

            item<"diferencia">:format(@@(item,"#saldofisico") - @@(item,"#saldoteorico"),"$ #,#.00")

            using item
            {
                saldofisico := format(@@(item,"#saldofisico"),"$ #,#.00")
                saldoteorico := format(@@(item,"#saldoteorico"),"$ #,#.00")
            }
        }

        new data
        {
            @"data*": entity
            @"almacenes*": dbr.list(db,"select sys_pk, codigo, descripcion from almacen where not ifnull(sys_deleted,0)",@null)
        }
        return data
    }
    
    delete::&db,&params
    {
        do dbr.apps.action.grant("GE43")

        do dbr.execute(db,"DELETE FROM cfCaptura WHERE IConteo=@_entity_id",params)
        do dbr.execute(db,"DELETE FROM cfExist WHERE IConteo=@_entity_id",params)
        do dbr.execute(db,"DELETE FROM cfConteo WHERE Sys_PK=@_entity_id",params)
    }
    cerrar::&db,&params,&data
    {
        do dbr.apps.action.grant("GE45")

        do dbr.execute(db,"UPDATE cfconteo SET cerrado = 1, conclusion = now() WHERE sys_pk=@_entity_id",params)
    }
    sincronizar::&db,&params,&data
    {
        do dbr.apps.action.grant("GE46")

        ref conteo=dbr.rec(db,"select sys_pk,sys_guid,nombre from cfconteo 
        where sys_pk=@_entity_id
        and ifnull(saldofisico,0) <> ifnull(saldoteorico,0)",params)

        if isnull(conteo){do rise_error(500,"No hay diferencias para sincronizar")}
        
        sql="select
                cfexist.sys_pk,
                cfexist.sys_guid,
                cfexist.ialmacen as ialmacen,
                cfexist.iproducto as iproducto,
                cfexist.costopromedio / divisa.tcambio as costopromedio,
                cfexist.exist_fisico,
                cfexist.exist_teorico,
                producto.costoultimo
            from
                (
                    cfexist
                    inner join producto on cfexist.iproducto = producto.sys_pk
                )
                inner join divisa on producto.idivisa = divisa.sys_pk
            where
                cfexist.exist_fisico <> cfexist.exist_teorico
                and cfexist.iconteo =@_entity_id"
        
        ref cfexists=dbr.list(db,ftext(sql),params)
    

        categoria=parse.num(dbr.vars.get(db,"cf_categoria"))
        //replaces
        macro_desc=dbr.vars.get(db,"plantilla_cardex")
        macro_desc=replace(macro_desc,"@cf_nombre",@@(conteo,"$nombre"))
        macro_desc=replace(macro_desc,"@cf_conteo",@@(conteo,"$sys_guid"))

        macro_ref=dbr.vars.get(db,"referencia_cardex")
        macro_ref=replace(macro_ref,"@cf_conteo",@@(conteo,"$sys_guid"))
        do dbr.begin(db)
            for i = 0; i < @count(cfexists)
            {
                ref exist=@item(cfexists,i)
                ref @LAST_DCARDEX=@null
                new dtcardex
                {
                    @"descripcion":macro_desc
                    @"icategoria":categoria
                    @"referencia":replace(macro_ref,"@cfe_id",@@(exist,"$sys_guid"))
                    @"fecha*":now()
                }
                ref cardex=dbr.save(db,"cardex",dtcardex)

                new dcardex
                {
                    @"ialmacen":@@(exist,"#ialmacen")
                    @"iproducto":@@(exist,"#iproducto")
                    @"referencia":cut(@@(exist,"$sys_guid"),30)
                    @"fk_cardex_movimientos":@@(cardex,"#sys_pk")
                }
                isentrada=@false
                if @@(exist,"#exist_fisico") > @@(exist,"#exist_teorico")
                {
                    //entrada
                    if @@(exist,"#costopromedio") > 0{dcardex<"cargos">:@@(exist,"#costopromedio") * (@@(exist,"#exist_fisico") - @@(exist,"#exist_teorico"))}
                    else{dcardex<"cargos">:@@(exist,"#costoultimo") * (@@(exist,"#exist_fisico") - @@(exist,"#exist_teorico"))}

                    dcardex<"entradas">:@@(exist,"#exist_fisico") - @@(exist,"#exist_teorico")
                    isentrada=@true
                }
                else 
                {
                    //  Salida
                    //  Se validan y calculan las cantidades a salir...
                    cantidad= 0
                    if @@(exist,"#exist_fisico") >= 0
                    {
                        cantidad= @@(exist,"#exist_teorico") - @@(exist,"#exist_fisico") 
                    }
                    else 
                    {
                        if (@@(exist,"#exist_teorico") + @@(exist,"#exist_fisico") )== 0
                        {
                            cantidad= @@(exist,"#exist_teorico") 
                        }
                        else
                        {
                            cantidad=@@(exist,"#exist_fisico") * (-1) 
                        }
                    }
                    
                    if @@(exist,"#costopromedio") > 0{dcardex<"abonos">:@@(exist,"#costopromedio") * cantidad}
                    else{dcardex<"abonos">:@@(exist,"#costoultimo") * cantidad }

                    dcardex<"salidas">:cantidad
                }
                
                if @@(dcardex,"#entradas")!= 0 || @@(dcardex,"#salidas")!= 0
                {
                    do dbr.save(db,"dcardex",dcardex)

                    do erp.inventario.aplicar_mov(db,@@(cardex,"#sys_pk"),isentrada)
                }
            }

            do dbr.execute(db,"update cfconteo set cerrado=1, sincronizado=1, conclusion=now() where sys_pk=@_entity_id",params)
        do dbr.commit(db)
        
        exception
        {
            if dbr.in_transaction(db){do dbr.rollback(db)}
            error=last_error()

            if isset("@LAST_DCARDEX") && not(isnull(@LAST_DCARDEX)) && not(contains(trim(error),trim(@@(@LAST_DCARDEX,"$cod_prod"))))
            {
                error=error + "\r\nProducto: "+@@(@LAST_DCARDEX,"$cod_prod")+" - "+@@(@LAST_DCARDEX,"$desc_prod")
            }

            do rise_error(last_error_code(),error)
        }
        
    }
    search.almacen::&db,&params
    {
        sql="SELECT 
                a.sys_pk,
                a.codigo,
                CONCAT(a.codigo,' - ',a.descripcion) descripcion
            FROM almacen a 
            WHERE IFNULL(a.sys_deleted,0)=0
            AND CONCAT_WS('',a.codigo,a.descripcion) like concat('%',@s,'%')
            ORDER BY a.codigo desc limit 200"

        if not(parse.bool(@@(params,"$_by_entity")))
        {
            return dbr.list(db,sql,params)
        }
        else 
        {
           return dbr.list(db,"SELECT distinct a.sys_pk,CONCAT(a.codigo,' - ',a.descripcion)descripcion 
                        FROM almacen a 
                        INNER JOIN cfexist c ON a.sys_pk=c.ialmacen
                        WHERE IFNULL(a.sys_deleted,0)=0
                        AND c.iconteo=@_entity_id",params)
        }
        
    }
    details::&db,&params
    {
        do dbr.apps.action.grant("GE42")
            
        sql = "
        SELECT 
            a.sys_pk id_almacen,
            p.sys_pk id_producto,
            l.sys_pk id_linea,
            m.sys_pk id_marca,
            ce.sys_pk id_conteo,
            p.codigo cod_prod,
            CONCAT(a.codigo,' - ',a.descripcion) almacen,
            CONCAT(p.codigo,' - ',p.descripcion) producto,
            CONCAT(l.codigo,' - ',l.descripcion) linea,
            CONCAT(m.codigo,' - ',m.descripcion) marca,
            @costopromedio := ifnull(ce.costopromedio,0) costopromedio,
            ce.exist_fisico,
            ce.exist_teorico,
            p.unidad,
            IFNULL(ce.exist_fisico,0) - IFNULL(ce.exist_teorico,0) AS diferencia,
            @valorfisico    := ROUND(IFNULL(@costopromedio,0) * IFNULL(ce.exist_fisico,0),4) valorfisico,
            @valorteorico   := ROUND(IFNULL(@costopromedio,0) * IFNULL(ce.exist_teorico,0),4) valorteorico,
            (@valorfisico - @valorteorico) diferenciavalor
        FROM cfexist ce 
            INNER JOIN producto p ON ce.iproducto=p.sys_pk
            INNER JOIN almacen a ON ce.ialmacen=a.sys_pk
            INNER JOIN linea l ON p.ilinea=l.sys_pk
            LEFT JOIN marca m ON p.imarca=m.sys_pk
        WHERE
            NOT IFNULL(ce.sys_deleted,0)
            AND ce.iconteo=@_entity_id
            AND IF(IFNULL(@fil_almacen,'*')='*',true,ce.ialmacen=@fil_almacen)
            AND IF(ifnull(@s,'')='',true, concat_ws(';',a.codigo,p.codigo,l.codigo,a.descripcion,l.descripcion,p.descripcion,p.unidad,m.codigo,m.descripcion) like concat('%',@s,'%'))
        LIMIT #<@default_max_rows>
        "
        
        ref conteo = dbr.rec(db,"
            select
                c.sys_pk,
                c.cerrado,
                c.conclusion,
                date_format(c.inicio,'%Y-%m-%d') inicio,
                c.nombre,
                c.notas,
                c.parcial,
                ROUND(ifnull(c.saldofisico,0),2) saldofisico,
                ROUND(ifnull(c.saldoteorico,0),2) saldoteorico,
                c.sincronizado
            from cfconteo c
            where c.sys_pk = @_entity_id
        ",params)
        
        if @@(conteo,"#parcial"){conteo<"tipo">:"Parcial"}
        else{conteo<"tipo">:"Completo"}

        if @@(conteo,"#cerrado")
        {
            conteo<"status">:"Abierto"
            conteo<"conclusion">:"En proceso"

            if @@(conteo,"#sincronizado")
            {
                conteo<"status">:"Sincronizado"
            }
            else{conteo<"status">:"Cerrado"}
        }
        else 
        {
            conteo<"status">:"Abierto"
            conteo<"conclusion">:"En proceso"
        }
        params._by_entity := @true
        ref almacenes=search.almacen(db,params)

        new entity{}

        entity.conteo       := ref conteo
        entity.data         := ref dbr.list(db,ftext(sql),params)
        entity.almacenes    := ref almacenes
        entity.m_decs     := 2 //parse.num(dbr.vars.get(db,"FXCA001"))
        entity.v_decs     := 2 //parse.num(dbr.vars.get(db,"FXCA002"))

        return entity
    }
    prod_cardex::&db,&params
    {
        new data{@"success":@true}

        sql="SELECT COUNT(*) FROM dcardex d WHERE d.iproducto=@prod"
        if not(parse.bool(@@(params,"$fromchange"))) && dbr.num(db,sql,params) < 1 
        {
            data<"message">:"El producto no ha tenido movimientos de inventario. ¿Desea continuar?"
            return data
        }

        sql="SELECT COUNT(*) FROM dcardex d WHERE d.ialmacen=@alm and d.iproducto=@prod"
        if dbr.num(db,sql,params) < 1{data<"message">:"El producto no ha tenido movimientos de inventario en el almacén seleccionado. ¿Desea continuar?"}

        return data
    }
    GetExistence::&db,producto,almacen
    {
        producto,almacen >> p
        sql="select ifnull(existencia,0) from existencias where ialmacen =@almacen and fk_producto_iexistencias =@producto"

        return dbr.num(db,sql,p)
    }
    ValidarValor::&db,cantidadcap,producto,almacen,conteo
    {
        producto,almacen,conteo >> p
        sql = "select cfexist.sys_pk, cfexist.costopromedio,cfexist.exist_fisico 
        from cfexist 
        where cfexist.iproducto=@producto and cfexist.ialmacen=@almacen and cfexist.iconteo=@conteo"

        ref data=dbr.rec(db,sql,p)
        cantidad_acum=@@(data,"#exist_fisico")

        cantidadtotal=cantidad_acum + cantidadcap

        existencia=GetExistence(db,producto,almacen)

        if (cantidadtotal * -1) > existencia
        {
            if cantidad_acum== 0{do rise_error(99,"Debe capturar una cantidad menor o igual a la existencia teórica.")}
            else {return @false}
        }

        return @true
    }
    registrar::&db,&params,&data
    {
        @use_transaction = @false
            do dbr.apps.action.pre("GE44")
        do dbr.begin(db)
        
        ref producto=@@(data,"&producto")
        new cfcaptura
        {
            @"cantidad":round(@@(data,"#cantidad"),6)
            @"ialmacen":@@(data,"#almacen")
            @"iproducto":@@(producto,"#sys_pk")
            @"notas":@@(data,"$notas")
            @"referencia":@@(data,"$referencia")
            @"iconteo":@@(params,"#_entity_id")
            @"usuario":@@(@http_context,"$session/user/uid")
        }

        //validar existencia teórica contra la existen física negativa
        if @@(cfcaptura,"#cantidad") < 0
        {
            validar=ValidarValor(db,@@(cfcaptura,"#cantidad"),@@(cfcaptura,"#iproducto"),@@(cfcaptura,"#ialmacen"),@@(cfcaptura,"#iconteo"))
            if not(validar)
            {
                message="La existencia física acumulada de manera negativa sobrepasa la existencia teórica de este producto, verifique los datos capturados."
                do rise_error(500,message)
            }
            else if @@(data,"#show_msg")
            {
                cfcaptura<"message">:"Está capturando la cantidad con un valor negativo, esto hará disminuir la existencia física. ¿Está seguro que desea continuar?"
                cfcaptura<"execute">:@true
                return cfcaptura
            }
        }
        if trim(@@(cfcaptura,"$referencia"))!=""
        {
            cod_almacen=dbr.str(db,"select codigo from almacen where sys_pk=@ialmacen",cfcaptura)
            cfcaptura<"referencia">:cut(cod_almacen+"-"+@@(producto,"$codigo"),50)
        }
        
        costopromedio=dbr.num(db,"select ifnull(costopromedio,0) from cfexist
                        where iconteo=@iconteo
                        AND ialmacen=@ialmacen
                        AND iproducto=@iproducto",cfcaptura)

        if costopromedio < 1
        {
            new e
            {
                @"almacen":@@(cfcaptura,"#ialmacen")
                @"ppk":@@(cfcaptura,"#iproducto")
            }
            ref ext=dbr.rec(db,@__sql_existencia,e)
            costopromedio=caculateCostoPromedio(ext)
            
            if costopromedio > 0
            {
                do dbr.execute(db,"update cfexist set costopromedio="+str(costopromedio)+"
                        where iconteo=@iconteo
                        AND ialmacen=@ialmacen
                        AND iproducto=@iproducto",cfcaptura)
            }
        }
        do dbr.execute(db,"update cfconteo set saldofisico=ifnull(saldofisico,0) + (@cantidad * "+str(costopromedio)+") where sys_pk=@iconteo",cfcaptura)
        do dbr.execute(db,"update cfexist set exist_fisico=ifnull(exist_fisico,0) + @cantidad 
                        where iconteo=@iconteo
                        AND ialmacen=@ialmacen
                        AND iproducto=@iproducto",cfcaptura)

            ref captura=dbr.save(db,"cfcaptura",cfcaptura)

            sfisico=dbr.num(db,"select ROUND(sum(ifnull(saldofisico,0)),2) from cfconteo where sys_pk=@iconteo",cfcaptura)
            captura<"sfisico">:format(sfisico,"$ #,#.00")

            captura<"cant_row_captura">:dbr.num(db,"SELECT ifnull(SUM(IFNULL(c.cantidad,0)),0) 
            FROM cfcaptura c 
            WHERE c.iconteo=@iconteo 
            AND c.ialmacen=@ialmacen
            AND C.iproducto=@iproducto
            ",cfcaptura)
        
            do dbr.apps.action.pos(captura)
        do dbr.commit(db)
            do dbr.apps.action.ext(captura)
        
        return captura

        exception
        {
            if dbr.in_transaction(db){ do dbr.rollback(db) }
            do dbr.apps.action.log()
            do rise_error(last_error_code(),last_error())
        }
    }
    export.e.import::&db,&params,&data
    {
        do errordet(@false)

        ref conteo=dbr.rec(db,"select sys_pk,sys_guid,nombre from cfconteo where sys_pk=@_entity_id",params)
        if isnull(conteo){do rise_error(500,"No se encontró datos del conteo indicado")}

        switch @@(data,"$type")
        {
            case "html"
            {
                path=export.html(data,@@(conteo,"$sys_guid")+".html")
                break
            }
            case "csv"
            {
                path=export.csv(data,@@(conteo,"$sys_guid")+".csv")
                break
            }
            case "import"
            {
                path=import.text(db,params,"Error_"+@@(conteo,"$sys_guid")+".log")
                break
            }
            default
            {
                path=export.text(data,@@(conteo,"$sys_guid")+".txt")
                break
            }
        }
        
        new record{ }

        if path!=""
        {
            using record{@"url":replace(@URL_DOWNLOAD,"@path",url_encode(path))}
        }
        
        return record
    }

    export.file::body,filename
    {
        path="data/"+@@(@http_context,"$session/idp/qname")+"/inventario/conteo_fisico/"
        do dir.ensure(path)

        path=path + filename
        do file.wtext(path,body)

        return path
    }
    export.text::&array,filename
    {
        ref data=@@(array,"&data")
        title="Almacen	Codigo	Descripcion	Linea	Marca	Unidad	CostoPromedio	Exist_Fisico	Exist_Teorico	Diferencia	ValorFisico	ValorTeorico	Diferencia_Valor"

        body=""
        for i = 0; i < @count(data)
        {
            ref dt=@item(data,i)
            body=body + @@(dt,"$almacen")+"\t"
            body=body + @@(dt,"$cod_prod")+"\t"
            body=body + @@(dt,"$producto")+"\t"
            body=body + @@(dt,"$linea")+"\t"
            body=body + @@(dt,"$marca")+"\t"
            body=body + @@(dt,"$unidad")+"\t"
            body=body + @@(dt,"$costopromedio")+"\t"
            body=body + @@(dt,"$exist_fisico")+"\t"
            body=body + @@(dt,"$exist_teorico")+"\t"
            body=body + @@(dt,"$diferencia")+"\t"
            body=body + @@(dt,"$valorfisico")+"\t"
            body=body + @@(dt,"$valorteorico")+"\t"
            body=body + @@(dt,"$diferenciavalor")+"\t"
            body=body + "\r\n"
        }
        
        return export.file(title+"\r\n"+body,filename)
    }
    export.html::&array,filename
    {
        ref data=@@(array,"&data")

        html='<table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#ffffff">'
        html=html + '<tr>' 
        html=html + '<td>'
            //tablas
            html=html + '<table width="100%" border="1" cellspacing="0" cellpadding="0" background="">'
            html=html + '<td class="s0" colspan="120">almacen</td>
                        <td class="s0" colspan="60">codigo</td>
                        <td class="s0" colspan="120">descripción</td>
                        <td class="s0" colspan="116">línea</td>
                        <td class="s0" colspan="42">marca</td>
                        <td class="s0" colspan="46">unidad</td>
                        <td class="s0" colspan="83">costopromedio</td>
                        <td class="s0" colspan="67">exist_fisico</td>
                        <td class="s0" colspan="76">exist_teorico</td>
                        <td class="s0" colspan="69">diferencia</td>
                        <td class="s0" colspan="63">valorfisico</td>
                        <td class="s0" colspan="90">valorteorico</td>
                        <td class="s0" colspan="90">diferencia_valor</td>'

            for i = 0; i < @count(data)
            {
                ref dt=@item(data,i)
                html=html + '<tr>'
                    html=html + '<td class="s1" colspan="120">'+@@(dt,"$almacen")+'</td>'
                    html=html + '<td class="s1" colspan="60">'+@@(dt,"$cod_prod")+'</td>'
                    html=html + '<td class="s1" colspan="120">'+@@(dt,"$producto")+'</td>'
                    html=html + '<td class="s1" colspan="116">'+@@(dt,"$linea")+'</td>'
                    html=html + '<td class="s1" colspan="42">'+@@(dt,"$marca")+'</td>'
                    html=html + '<td class="s1" colspan="46">'+@@(dt,"$unidad")+'</td>'
                    html=html + '<td class="s2" colspan="83">'+@@(dt,"$costopromedio")+'</td>'
                    html=html + '<td class="s2" colspan="67">'+@@(dt,"$exist_fisico")+'</td>'
                    html=html + '<td class="s2" colspan="76">'+@@(dt,"$exist_teorico")+'</td>'
                    html=html + '<td class="s2" colspan="69">'+@@(dt,"$diferencia")+'</td>'
                    html=html + '<td class="s2" colspan="63">'+@@(dt,"$valorfisico")+'</td>'
                    html=html + '<td class="s2" colspan="90">'+@@(dt,"$valorteorico")+'</td>'
                    html=html + '<td class="s2" colspan="90">'+@@(dt,"$diferenciavalor")+'</td>'
                html=html + '</tr>'
            }
            
            html=html + '<tr>'
            html=html + '<td class="s2" colspan="799">&nbsp;</td>'
            html=html + '<td class="s2" colspan="63">'+@@(array,"$totales/vfisico")+'</td>'
            html=html + '<td class="s2" colspan="90">'+@@(array,"$totales/vteorico")+'</td>'
            html=html + '<td class="s2" colspan="90">'+@@(array,"$totales/vdiferencia")+'</td>'
            html=html + '</tr>'
            html=html + '</table>'
        html=html + '<td>' 
        html=html + '</tr>'
        html=html + '</table>'

        return export.file(html,filename)
    }
    export.csv::&array,filename
    {
        path= export.file("Almacen,Codigo,Descripcion,Linea,Marca,Unidad,CostoPromedio,Exist_Fisico,Exist_Teorico,Diferencia,ValorFisico,ValorTeorico,Diferencia_Valor",filename)
        ref data=@@(array,"&data")

        ref l=list.create()
        for i = 0; i < @count(data)
        {
            ref dt=@item(data,i)
            new obj
            {
                @"Almacen":@@(dt,"$almacen")
                @"Codigo":@@(dt,"$cod_prod")
                @"Descripcion":@@(dt,"$producto")
                @"Linea":@@(dt,"$linea")
                @"Marca":@@(dt,"$marca")
                @"Unidad":@@(dt,"$unidad")
                @"CostoPromedio":@@(dt,"$costopromedio")
                @"Exist_Fisico":@@(dt,"$exist_fisico")
                @"Exist_Teorico":@@(dt,"$exist_teorico")
                @"Diferencia":@@(dt,"$diferencia")
                @"ValorFisico":@@(dt,"$valorfisico")
                @"ValorTeorico":@@(dt,"$valorteorico")
                @"Diferencia_Valor":@@(dt,"$diferenciavalor")
            }
            do list.add(l,obj)
        }
        do CsvWrite(path,l)
        return path
    }   
    import.text::&db,&params,filename
    {
        ref files = @@(@http_context,"&request/files")
        if @count(files) < 1 { return @null}
        
        do dbr.apps.action.grant("GE44")

        ref conteo=dbr.rec(db,"select sys_pk,sys_guid,nombre from cfconteo where sys_pk=@_entity_id",params)
        if isnull(conteo){do rise_error(500,"No se encontró datos del conteo indicado")}

        txt_file=""
        for i = 0; i < @count(files)
        {
            ref file = @item(files,i)
            if file.exists(@@(file,"$temp_file")) && @@(file,"$filename")!="" && @@(file,"#size")>0
            {
                txt_file=file.rtext(@@(file,"$temp_file"))
                break
            }
        }
        ref data_file=split(trim(txt_file),"\r\n")
        if @count(data_file) < 1{do rise_error(500,"No hay datos para importar")}

        logs=""
        
        for i = 0; i < @count(data_file)
        {
            ref lines=split(trim(list.str(data_file,i)),"\t")

            if @count(lines)< 4{do rise_error(500,"Algunas filas les hace falta datos")}
            params<"_almacen">:trim(list.str(lines,0))
            params<"_producto">:trim(list.str(lines,1))

            almacen=dbr.num(db,"select sys_pk from almacen where codigo=@_almacen",params)
            if almacen< 1{do rise_error(500,"No se encontró el almacén indicado")}

            params<"almacen">:almacen
            ref producto=dbr.rec(db,"SELECT sys_pk,codigo,descripcion,unidad FROM producto p WHERE p.codbar1=@_producto OR p.codbar2=@_producto OR p.codbar3=@_producto ",params)
            if isnull(producto){do rise_error(500,"No se encontró el producto indicado")}

            if @count(lines)>4{unidad=trim(list.str(lines,5))}
            else{unidad=@@(producto,"$unidad")}

            new capture
            {
                @"cantidad":trim(list.str(lines,2))
                @"ialmacen":almacen
                @"producto*":producto
                @"notas":"Importación"
                @"referencia":trim(list.str(lines,3))
                @"iconteo":@@(params,"#_entity_id")
                @"unidad":unidad
            }

            do registrar(db,params,capture)

            exception
            {
                new obj_error
                {
                    @"fila":to.json(lines)
                    @"error":last_error()
                    @"linea":i + 1
                }
                logs=logs + to.json(obj_error) +"\r\n\r\n"
            }
        }

        
        path=""
        if logs!=""
        {
            path=export.file(logs,filename)
        }

        return path
    }
    obtenerProductos::&db, &params
	{
		sql = "
		SELECT DISTINCT
			p.sys_pk,
			p.codigo,
			p.descripcion,
			p.unidad,
			d.codigo divisa,
			IFNULL(p.costoultimo,0) costoultimo,
			SUM(IFNULL(ex.saldo,0)) saldo,
			SUM(IFNULL(ex.existencia,0)) existencia,
			p.reqlote,
			p.reqserie
			#<selects>
		FROM producto p
			INNER JOIN divisa d ON p.idivisa = d.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk 
            AND IF(IFNULL(@ialmacen1,0)>0,ex.ialmacen = @ialmacen1,TRUE)
            INNER JOIN cfexist cfe on p.sys_pk=cfe.iproducto
			#<joins>
		WHERE NOT IFNULL(p.sys_deleted,0)
            AND cfe.iconteo=@conteo
			#<conditions>
		GROUP BY p.codigo
		ORDER BY p.codigo
		LIMIT #<@default_max_rows>
		"

		if not(field.exist(params,"fil_almacen")) { params<"fil_almacen"> : -1 }
		if not(field.exist(params,"fil_claseprod")) { params<"fil_claseprod"> : -1 }
		if not(field.exist(params,"fil_linea")) { params<"fil_linea"> : -1 }

		conditions = ""
		
		if @@(params,"#tipo") > 0 { conditions = conditions + " AND p.itipo = @tipo" }
		if @@(params,"#fil_almacen") > 0 { conditions = conditions + " AND ex.ialmacen = @fil_almacen" }
		if @@(params,"#fil_claseprod") > 0 { conditions = conditions + " AND p.iclase = @fil_claseprod" }
		if @@(params,"#fil_linea") > 0 { conditions = conditions + " AND p.ilinea = @fil_linea" }
		
		if trim(@@(params,"$s")) != "" 
        { 
            conditions = conditions + " AND (p.codbar1=@s or p.codbar2=@s or p.codbar3=@s)
            OR concat_ws('',p.codigo,p.descripcion) LIKE CONCAT('%',@s,'%')" 
        }

		return dbr.list(db, ftext(sql), params)
	}
}