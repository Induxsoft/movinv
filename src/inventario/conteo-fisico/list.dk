#include "dkli.dkh"
#!
module "Conteo físico"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/lib2.dk"

    do @context.begin(@crud_context)

    ref entity = ifnull(@("&./entity"),record.create())
    ref detail = ifnull(@("&./details"),list.create())

    @_entity_id = @("$parameters/_entity_id")
    @is_new = (@_entity_id == "_new")

    table_id = "table_conteo_fisico"

    ref list_years = lib.list_years(10,0)
    fdr_year_opt = ""
    for i = 0; i < list.count(list_years) { fdr_year_opt = fdr_year_opt + list.str(list_years,i) + "," }
    fdr_year_opt = rremove(fdr_year_opt,1)

    new fil_fdr_field
    {
        @"datatable*": from.json('[
            {"id":1, "const":"Inicio"},
            {"id":2, "const":"Conclusión"}
        ]')
        @"id": "fil_fdr_field"
        member "attributes"
        {
            @"name": "fdr_field"
            @"class": "induxsoft-form-select"
            @"title": "Elegir columna para el rango de fechas"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"selected": @("#parameters/fdr_field")
    }

    new fil_almacen
    {
        @"datatable*": ifnull(@("&./almacenes"),list.create())
        @"id": "fil_almacen"
        member "attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "alm"
            @"title": "Filtrar por almacén"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"value_field": "sys_pk"
        @"text_field": "descripcion"
        @"first_value": "-1"
        @"first_text": "(Almacenes)"
        @"selected": @("parameters/alm")
    }

    new fil_status
    {
        @"datatable*": from.json('[
            {"id":1, "const":"Abierto"},
            {"id":2, "const":"Cerrado"},
            {"id":3, "const":"Sincronizado"}
        ]')
        @"id": "fil_status"
        member "attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "stt"
            @"title": "Filtrar por estados"
            @"onchange": "document.querySelector('#form_filter').submit();"
        }
        @"value_field": "id"
        @"text_field": "const"
        @"first_value": "-1"
        @"first_text": "(Estados)"
        @"selected": @("parameters/stt")
    }

    new table_definition
    {
        @"datatable*": ifnull(@("&./data"),list.create())
        @"table_footer": "Mostrando los primeros # registros más recientes"
        @"tableheight": "96%"
        member @"columns"
        {
            member @"nombre" { @"caption":"Nombre" }
            member @"inicio" { @"caption":"Inicio" }
            member @"conclusion" { @"caption":"Conclusión" }
            member @"status" { @"caption":"Estado" }
            member @"tipo" { @"caption":"Tipo" }
            member @"saldofisico" { @"caption":"S. Físico" }
            member @"saldoteorico" { @"caption":"S. Teórico" }
            member @"diferencia" { @"caption":"Diferencia" }
            member @"notas" { @"caption":"Notas" }
            member @"_actions"
            {
                @"no-print":@true
                @"caption":"Acciones"
                @"template":'<div style="display:flex;gap:8px;justify-content:center;">
                                <a href="./${DataRow.sys_pk}/details/" style="cursor:pointer; text-decoration: none; padding: 0px 8px; background-color: #F5F5F5; color: #000;border:1px solid;">Detalle</a>
                                <button style="border:1px solid;margin-right:5px;" onclick="InduxsoftCrudlModel.Delete(${DataRow.sys_pk})">Eliminar</button>
                                ${DataRow.cerrado ? ``:`<button style="border:1px solid;margin-right:5px;" onclick="conteo.CerrarConteo(${DataRow.sys_pk})">Cerrar conteo</button>`}
                                ${DataRow.sincronizado ? ``:`<button style="border:1px solid;margin-right:5px;" onclick="conteo.SincronizarConteo(${DataRow.sys_pk})">Sincronizar</button>`}
                            </div>'
            }
        }
    }

    fn_print_buttons::
    {
        act_btn_cls = "btn btn-sm border-secondary induxsoft-corners btn-main-action"
        
        #$
        a(href="./_new/" class="#<act_btn_cls>" type="button" id="btn_guardar"  title="Aceptar"){$"Nuevo"}
        #!
    }
    point print_buttons to fn_print_buttons
    new nav_config
    {
        @"title":"Conteo físico"
        @"buttons*": print_buttons
        @"urlexit": "/"
        @"print_mode": 0 // 0-window.print(), 1-v12PrintHTML()
        member @"hidden"{@"send":@true}
    }

    #$ div(class="container-fluid v12-list-view" id="view")
    {
        section(id="top_area")
        {
            #!
            do uie.printV12FormBar(nav_config)
            #$

            form(action="./" method="GET" id="form_filter" class="mb-1")
            {
                div(class="d-flex align-items-center")
                {
                    div
                    {
                        ##
                        do uie.dbSelect(fil_fdr_field)
                        ##
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-date-range"(
                            "form"="#form_filter"
                            "auto-submit"="true"
                            "custom-range"="true"
                            "selection"="#<to.json(@('&parameters'))>"

                            "mode-field"="fdr_mode"
                            "year-field"="fdr_year"
                            "month-field"="fdr_month"
                            "range-field"="fdr_range"
                            "from-field"="fdr_from"
                            "to-field"="fdr_to"
                            
                            "lastdays-options"="15,30,45,60,90"
                            "years-options"="#<fdr_year_opt>"
                            "month-names"="Enero,Febrero,Marzo,Abril,Mayo,Junio,Julio,Agosto,Septiembre,Octubre,Noviembre,Diciembre"
                            
                            "label-months"="Ver por cada mes"
                            "label-days"="Últ. @lastdays días"
                            "label-custom"="Personalizado"
                            "label-from"="Desde:"
                            "label-to"="Hasta:"
                        ){$""}
                    }
                }

                div(class="d-flex align-items-center gap-2 flex-wrap w-100 py-1")
                {
                    div(class="d-flex gap-2")
                    {
                        div{ #! do uie.dbSelect(fil_almacen) } #$
                        div{ #! do uie.dbSelect(fil_status) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="fil_text"
                            "text-field"="s"
                            "placeholder"="Buscar por Nombre, Notas"
                            "form"="#form_filter"
                            "value"="#<@('$parameters/s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
            }
        }
        section(id="work_area")
        {
            #!
            do uie.dbeditable(table_definition,table_id)
            #$
        }
        section(id="bottom_area")
        {
            //////////////////////////////////////////////////////////////////
            div(id="_custom_area")
            {
                script(src="#<@JS_CONTEO_FISICO>"){""}
                script(type="text/javascript")
                {$'
                    function getCurrentContext() {
                        const table = document.getElementById("#<table_id>");
                        const id = (table?.DataArray[table.CurrentRowIndex()]?.sys_pk ?? "");
                        return { item_id:id, context: {} }
                    }
                    
                    document.addEventListener("DOMContentLoaded", () => {
                        // Script injection
                        #<@@(@crud_context,"script")>
                    });
                '}
            }
        }
    }
}