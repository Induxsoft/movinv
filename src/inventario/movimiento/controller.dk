#include "dkli.dkh"
#!
module "controller"
{
    switch @@(@http_context,"$request/get/_view")
    {
        case "entrada"
        {
            @form_view = "entrada.dk"
            break
        }
        case "salida"
        {
            @form_view = "salida.dk"
            break
        }
        case "traspaso"
        {
            @form_view = "traspaso.dk"
            break
        }
        case "existencias"
        {
            @form_view = "existencias.dk"
            point @read to movinv.existencias
            break
        }
        case "almacen"
        {
            point @list to movinv.obtenerAlmacenes
            break
        }
        case "categoria"
        {
            point @list to movinv.obtenerCategorias
            break
        }
        case "producto"
        {
            point @list to movinv.obtenerProductos
            break
        }
        case "obtener-lineas"
        {
            point @list to movinv.GetLineaByClase
            break
        }
        case "obtener-lotes-de-producto"
        {
            point @list to movinv.obtenerLotesDeProducto
            break
        }
        case "obtener-series-de-producto"
        {
            point @list to movinv.obtenerSeriesDeProducto
            break
        }
        default
        {
            point @create to movinv.agregar
            point @update to movinv.agregar
            point @list to movinv.list
            break
        }
    }
}