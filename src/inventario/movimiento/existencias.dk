#include "dkli.dkh"
#!
module "existencias.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/lib2.dk"

    do @context.begin(@crud_context)

    ref producto = ifnull(@("&./producto"),record.create())
    ref existencias = ifnull(@("&./existencias"),list.create())
    ref transferencias = ifnull(@("&./transferencias"),list.create())

    @_entity_id = @("$parameters/_entity_id")
    @current_url = lib.curr_url()

    function fn_before_cell(&params,&row,&cell)
    {
        if @@(cell,"cell_type")!="data" && @@(cell,"cell_type")!="unknow" { return }
        if @@(cell,"$column") == "ubicacion"
        {
            sys_pk = @@(row,"$iexistencia")
            value = @@(row,"$ubicacion")
            id = "sf-"+sys_pk
            onchange = "saveUbicacion("+sys_pk+",this.value);"
            
            cell<"text"> : ftext('
                <safe-input type="text" value="#<value>" id="#<id>" placeholder="Indicar ubicación" onchange="#<onchange>"></safe-input>
            ')
        }
        if @@(cell,"$column") == "_actions"
        {
            btn_style = "cursor:pointer; text-decoration:none; padding:0px 8px; background-color:#F5F5F5; color:#000;"
            ver_cardex_link = path.concat(replace(@INV_GET_DOCUMENTO,"@id",@_entity_id), "?almc="+@@(row,"$ialmacen"))
            edt_maxmin_link = "/!/inventario/maxmin/_edt/?iproducto="+@_entity_id+"&ialmacen="+@@(row,"$ialmacen")+"&exiturl="+url_encode(@current_url)

            cell<"text"> : ftext('
                <a href="#<ver_cardex_link>" style="#<btn_style>">Cardex</a>
                <a href="#<edt_maxmin_link>" style="#<btn_style>" title="Editar máximo, mínimo, p. reorden">MaxMin</a>
            ')
        }
    }
    point before_cell to fn_before_cell

    new def_table_ex
    {
        @"id": "tbl_existencias"
        @"datatable*": existencias
        @"show_summary": @true
        @"before_cell*": before_cell

        member @"attributes"
        {
            @"class": "table table-sm table-bordered"
        }
        
        member @"columns"
        {
            member @"dalmacen" { @"caption": "Almacén" }
            member @"ubicacion" { @"caption": "Ubicación" }
            member @"minimo"
            {
                @"caption": "Mínimo"
                @"format": "#,0.0000"
            }
            member @"maximo"
            {
                @"caption": "Máximo"
                @"format": "#,0.0000"
            }
            member @"preorden"
            {
                @"caption": "P. Reorden"
                @"format": "#,0.0000"
            }
            member @"existencia"
            {
                @"caption": "Existencia"
                @"format": "#,0.0000"
                @"summary": "sum"
            }
            member @"saldo"
            {
                @"caption": "Saldo"
                @"format": "$ #,0.0000"
                @"summary": "sum"
            }
            member @"_actions" { @"caption": "Acciones" }
        }
    }

    new def_table_tr
    {
        @"id": "tbl_transferencias"
        @"datatable*": transferencias
        @"show_summary": @true

        member @"attributes"
        {
            @"class": "table table-sm table-bordered"
        }
        
        member @"columns"
        {
            member @"fecha" { @"caption": "Fecha" }
            member @"referencia" { @"caption": "Referencia" }
            member @"alm_origen" { @"caption": "Almacén origen" }
            member @"salidas"
            {
                @"caption": "Cantidad"
                @"format": "#,0.000"
                @"summary": "sum"
            }
            member @"unidad" { @"caption": "Unidad" }
            member @"abonos"
            {
                @"caption": "Importe"
                @"format": "$ #,0.000"
                @"summary": "sum"
            }
            member @"alm_destino" { @"caption": "Almacén destino" }
        }
    }

    new navbar_settings
    {
        @"title": "Existencias por almacén"
        @"urlexit": @INVENTARIO
    }

    #$
    div(class="v12-list-view" id="view")
    {
        section(class="container-fluid bg-white" id="top_area")
        {
            #!
            do uie.printV12FormBar(navbar_settings)
            #$
        }

        div(class="#<ifstr(@('error/message')!='','alert alert-danger','')> overflow-auto"){$"#<@('error/message')>"}

        section(class="container-fluid bg-white" id="work_area")
        {
            div(class="show-on-print"){
            div(class="row")
            {
                div(class="col-3 text-start")
                {
                    small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                    small(class="d-block"){ b{$"Impresión: "} $"#<date_str(now(),'dd/MMM/yyyy')>" }
                }
                div(class="col-6 text-center")
                {
                    h4(class=""){$"Informe de existencias por almacén del producto"}
                }
                div(class="col-3 text-end")
                {
                    $""
                }
            }}

            div(class="d-flex justify-content-end flex-wrap gap-3 mb-1")
            {
                h6(class="flex-grow-1"){$"#<@@(producto,'$tproducto')>"}

                span{ small(class="fw-bold"){$"Existencia y saldo: "} $"#<format(@@(producto,'#existencia'),'#,0.0000')>" }
                span{ small(class="fw-bold"){$""} $"#<@@(producto,'$unidad')>" }
                span{ small(class="fw-bold"){$""} $"#<@@(producto,'$cdivisa')>" }
                span{ small(class="fw-bold"){$""} $"#<format(@@(producto,'#saldo'),'$ #,0.0000')>" }

                small(class="text-muted"){$"|"}

                span{ small(class="fw-bold"){$"Mínimo: "} $"#<format(@@(producto,'#minimo'),'#,0.0000')>" }
                span{ small(class="fw-bold"){$"Máximo: "} $"#<format(@@(producto,'#maximo'),'#,0.0000')>" }
                span{ small(class="fw-bold"){$"P. Reorden: "} $"#<format(@@(producto,'#preorden'),'#,0.0000')>" }
            }

            div(class="table-container my-2")
            {
                style
                {$'
                    table th { text-align:center; }

                    #tbl_existencias td:nth-child(8),
                    #tbl_transferencias td:nth-child(4),
                    #tbl_transferencias td:nth-child(5)
                    { text-align:center; }

                    #tbl_existencias td:nth-child(3),
                    #tbl_existencias td:nth-child(4),
                    #tbl_existencias td:nth-child(5),
                    #tbl_existencias td:nth-child(6),
                    #tbl_existencias td:nth-child(7),
                    #tbl_transferencias td:nth-child(6)
                    { text-align:end; }
                '}
                #!
                do uie.dbTable(def_table_ex)
                #$

                h6{"Transferencias en proceso"}

                #!
                do uie.dbTable(def_table_tr)
                #$
            }
        }

        //////////////////////////////////////////////////////////////////
        div(id="_custom_area")
        {
            script(type="text/javascript")
            {$'
                function saveUbicacion(pk,text) {
                    const sf = document.getElementById("sf-"+pk);
                    
                    InduxsoftCrudlModel.InvokeService("./", {iexistencia:pk, ubicacion:text}, 
                    (data) => {
                        if (data.message) {
                            alert(data.message);
                            sf._cancelEdit();
                            return
                        }
                        sf._tempValue = text;
                        console.log("Ubicación actualizada.");
                    },
                    (error) => {
                        alert(error.message ?? JSON.stringify(error));
                        sf._cancelEdit();
                    },
                    "PATCH", false);
                }
            '}
        }
    }
    #!

    do @context.end()
}