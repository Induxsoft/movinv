#include "dkli.dkh"
#!
module "model"
{
	// #include "../config.dk"
	#include "../movimientos.dkh"

	// =============== ALMACEN
	function movinv.obtenerAlmacenes(&db, &params)
	{
		sql = "
		SELECT
			sys_pk,
			codigo,
			descripcion,
			CONCAT(codigo,' - ',descripcion) AS dalmacen
		FROM almacen
		WHERE NOT IFNULL(sys_deleted,0)
			AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')));"

		return dbr.list(db, sql, params)
	}
	// =============== CATEGORÍA
	function movinv.obtenerCategorias(&db, &params)
	{
		sql = "
		SELECT sys_pk, codigo, descripcion
		FROM categoria
		WHERE tipo = 3
			AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')))
		ORDER BY codigo;"

		return dbr.list(db, sql, params)
	}

	function movinv.buscarCardex(&db,&params)
	{
		sql_search = "
		SELECT sys_pk, referencia, descripcion, IFNULL(DATE_FORMAT(fecha,'%Y-%m-%d'),'') fecha
			
		FROM cardex
		WHERE descripcion LIKE CONCAT('%',@s,'%') OR referencia = @s
		"

		if trim(@@(params,"$s")) == "" { return list.create() }
		return dbr.list(db,sql_search,params)
	}

	function movinv.buscarSeriesP(&db,&params)
	{
		sql_search = "
		SELECT s.sys_pk, s.numero,
			IFNULL(DATE_FORMAT(s.fentrada,'%Y-%m-%d'),'') fentrada,
			e.const estado,
			IFNULL(DATE_FORMAT(s.fventa,'%Y-%m-%d'),'') fventa,
			CONCAT(
				IFNULL(DATE_FORMAT(s.fentrada,'%Y-%m-%d'),''), ' / ',
				e.const, ' / ',
				IFNULL(DATE_FORMAT(s.fventa,'%Y-%m-%d'),'')
			) descripcion
		FROM serie s
			INNER JOIN cstatusseries e ON s.`status` = e.id
		WHERE s.numero LIKE CONCAT('%',@s,'%')
		"

		if trim(@@(params,"$s")) == "" { return list.create() }
		return dbr.list(db,sql_search,params)
	}

	// ============== LINEA
	function movinv.GetLineaByClase(&db,&params)
    {
        return dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM linea WHERE NOT IFNULL(sys_deleted,0) AND clase = @iclase",params)
    }
	// =============== LOTES DE PRODUCTO
	function movinv.obtenerLotesDeProducto(&db,&params)
	{
		sql = "
		SELECT
			lot.sys_pk AS ilote,
			lxa.ialmacen,
			lot.numero,
			lxa.cantidad,
			IFNULL(DATE_FORMAT(lot.fcaducidad,'%Y-%m-%d'),'') AS fcaducidad,
			alm.descripcion AS `almacen`
		FROM lote AS lot
			INNER JOIN clotexalmacen AS lxa ON lot.sys_pk = lxa.fk_lote_exisxalmacen
			INNER JOIN almacen AS alm ON lxa.ialmacen = alm.sys_pk
		WHERE NOT IFNULL(lot.sys_deleted,0)
			AND lxa.cantidad > 0
			AND lot.iproducto = @iproducto
			AND lxa.ialmacen = @ialmacen
		"
		return dbr.list(db,sql,params)
	}
	// =============== SERIES DE PRODUCTO
	function movinv.obtenerSeriesDeProducto(&db,&params)
	{
		sql = "
		SELECT
			ser.sys_pk AS iserie,
			ser.numero,
			stt.const AS cstatus,
			IFNULL(lot.numero,'') AS num_lote
		FROM serie AS ser
			LEFT JOIN lote AS lot ON ser.ilote = lot.sys_pk
			INNER JOIN cstatusseries AS stt ON ser.status = stt.id
		WHERE NOT IFNULL(ser.sys_deleted,0)
			AND ser.status IN (1,4)
			AND ser.iproducto = @iproducto
			AND ser.ialmacen = @ialmacen
		"
		return dbr.list(db,sql,params)
	}
	// =============== PRODUCTOS
	function movinv.obtenerExistencias(&db,&params)
	{
		iproducts = trim(@@(params,"$iproducts"))
		
		sql = "
		SELECT
			p.sys_pk AS iproducto,
			IFNULL(e.existencia,0) AS existencia
		FROM producto AS p
			LEFT JOIN existencias AS e ON e.fk_producto_iexistencias = p.sys_pk
		WHERE e.ialmacen = @ialmacen AND p.sys_pk IN(#<iproducts>)
		"
		return dbr.list(db,ftext(sql),params)
	}

	function movinv.obtenerProductos(&db, &params)
	{
		if @@(params,"$_act") == "existencias" { return movinv.obtenerExistencias(db,params) }

		sql = "
		SELECT
			p.sys_pk,
			p.codigo,
			p.descripcion,
			p.unidad,
			d.codigo divisa,
			IFNULL(p.costoultimo,0) costoultimo,
			SUM(IFNULL(ex.saldo,0)) saldo,
			SUM(IFNULL(ex.existencia,0)) existencia,
			p.reqlote,
			p.reqserie
			#<selects>
		FROM producto p
			INNER JOIN divisa d ON p.idivisa = d.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk AND IF(IFNULL(@ialmacen1,0)>0,ex.ialmacen = @ialmacen1,TRUE)
			#<joins>
		WHERE NOT IFNULL(p.sys_deleted,0)
			#<conditions>
		GROUP BY p.codigo
		ORDER BY p.codigo
		LIMIT #<@default_max_rows>
		"

		if not(field.exist(params,"fil_almacen")) { params<"fil_almacen"> : -1 }
		if not(field.exist(params,"fil_claseprod")) { params<"fil_claseprod"> : -1 }
		if not(field.exist(params,"fil_linea")) { params<"fil_linea"> : -1 }

		conditions = ""
		
		if @@(params,"#tipo") > 0 { conditions = conditions + " AND p.itipo = @tipo" }
		if @@(params,"#fil_almacen") > 0 { conditions = conditions + " AND ex.ialmacen = @fil_almacen" }
		if @@(params,"#fil_claseprod") > 0 { conditions = conditions + " AND p.iclase = @fil_claseprod" }
		if @@(params,"#fil_linea") > 0 { conditions = conditions + " AND p.ilinea = @fil_linea" }
		
		if trim(@@(params,"$s")) != "" { conditions = conditions + " AND (p.codigo LIKE CONCAT('%',@s,'%') OR p.descripcion LIKE CONCAT('%',@s,'%'))" }

		if @@(params,"$_mov") == "traspaso"
		{
			selects = ""

			if @@(params,"#ialmacen1") > 0
			{
				selects = ",
				(
					SELECT SUM(IFNULL(ex1.existencia, 0))
					FROM existencias ex1
					WHERE ex1.fk_producto_iexistencias = p.sys_pk
					AND ex1.ialmacen = @ialmacen1
				) AS exist_origen
				"
			}
			if @@(params,"#ialmacen2") > 0
			{
				selects = selects + ",
				(
					SELECT SUM(IFNULL(ex2.existencia, 0))
					FROM existencias ex2
					WHERE ex2.fk_producto_iexistencias = p.sys_pk
					AND ex2.ialmacen = @ialmacen2
				) AS exist_destino
				"
			}
		}

		return dbr.list(db, ftext(sql), params)
	}

	function movinv.list(&db,&params)
	{
		do dbr.apps.action.grant("GE10")

		params<"tipo"> : 2 // cInventariable

		new data
		{
			@"data*": movinv.obtenerProductos(db,params)
			@"list_almacenes*": movinv.obtenerAlmacenes(db,params)
			@"list_claseproducto*": dbr.list(db,"SELECT id, const FROM cclaseproducto",@null)
			@"list_lineas*": dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM linea WHERE NOT IFNULL(sys_deleted,0) AND clase = @fil_claseprod",params)
		}

		return data

		exception
        {
            do errordet(@false)
			code = last_error_code()
			error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
	}

	// =============== MOVIMIENTOS
	function movinv.agregarMovimiento(&db, &params, &data)
	{
		new p{@"referencia":@@(data,"$referencia")}
		if trim(@@(data,"$referencia"))==""{data<"referencia*">:@null}
		if trim(@@(data,"$referencia"))!=""
		{
			ref rec=dbr.rec(db,"select * from cardex where referencia=@referencia",p)
			if not(isnull(rec)){do rise_error(500,"El valor de la referencia ya existe")}
		}
		almacen1 = 0
		almacen2 = 0

		tipo_mov = @@(data, "$tipo_movimiento")

		if field.exist(data, "ialmacen") {
			almacen1 = @@(data,"#ialmacen")
			do field.remove(data, "ialmacen")
		}
		else {
			do rise_error(0, "Se esperaba el parámetro 'ialmacen'")
		}

		if tipo_mov == "traspaso" && not(field.exist(data, "ialmacen2")) {
			do rise_error(0, "Se esperaba el parámetro 'ialmacen2'")
		}
		else  {
			almacen2 = @@(data,"#ialmacen2")
			do field.remove(data, "ialmacen2")
		}

		ref productos = @@(data, "&_productos")
		valuar = @false
		
		do field.remove(data, "tipo_movimiento")

		if not(isnull(productos)) && list.count(productos) > 0
		{
			ref detalle = list.create()
			
			for i = 0; i < list.count(productos)
			{
				ref producto = list.obj(productos, i)
				ref dcardex = @null

				switch tipo_mov
				{
					case "entrada"
					{
						ref dcardex = movinv.genDetalle(producto, almacen1, @true)
						do movinv.setSerieLote(db,producto,dcardex,@mEntrada)
						do list.add(detalle, dcardex)
						break
					}
					case "salida"
					{
						ref dcardex = movinv.genDetalle(producto, almacen1, @false)
						do movinv.setSerieLote(db,producto,dcardex,@mSalida)
						do list.add(detalle, dcardex)
						valuar = @true
						break
					}
					case "traspaso"
					{
						// Salida
						@mover_serie = @true
						valuar = @true
						ref dcardex1 = movinv.genDetalle(producto, almacen1, @false)
						do movinv.setSerieLote(db,producto,dcardex1,@mTraspaso)
						do list.add(detalle, dcardex1)
						// Entrada
						if not(@@(data,"#mov_2p")) //No efectuar la entrada si se ha marcado como operación en dos pasos
						{
							@mover_serie = @false
							ref dcardex2 = movinv.genDetalle(producto, almacen2, @true)
							do movinv.setSerieLote(db,producto,dcardex2,@mTraspaso)
							do list.add(detalle, dcardex2)
						}
						break
					}
				}
			}

			do field.remove(data, "_productos")
			data<"_detalle*">: detalle
			
			using @childs
			{
				member "_detalle"
				{
					@"joinfield": "fk_cardex_movimientos"
					@"keyfield": "sys_pk"
					@"table": "dcardex"
					@"select_query": "SELECT NOW();"
					@"fields": "abonos,auditado,cargos,contabilizado,cpromedio,entradas,resto,salidas,tipocambio,valuado,ialmacen,iproducto,ilote,iserie"
				}
			}
		}

		// @use_transaction = @false
		
		// do dbr.begin(db)
		es_orden_transferencia=@false
		if field.exist(data,"mov_2p") 
		{ 
			es_orden_transferencia=@@(data,"#mov_2p")
			do field.remove(data,"mov_2p") 
		}

		ref res = record.caseinsensitive(entity.create(db, params, data))
		do erp.inventario.aplicar_mov(db,@@(res,"#sys_pk"),valuar)

		if es_orden_transferencia
		{
			new orden
			{
				ref_salida:=@@(res,"#sys_pk")
				ref_origen:=almacen1
				ref_destino:=almacen2
				completada:=@false
				cancelada:=@false
			}
			do dbr.save(db,"inv_orden_traspaso",orden)
		}
		// do dbr.commit(db)
		
		return res

		/* exception
		{
			// if dbr.in_transaction(db){do dbr.rollback(db)}
			do errordet(@false)
			do rise_error(last_error_code(),last_error())
		} */
	}

	movinv.agregar::&db,&params,&data
	{
		@use_transaction = @false

		new action
		{
			@"entrada": "GE11"
			@"salida": "GE12"
			@"traspaso": "GE13"
		}

        do dbr.apps.action.pre(@@(action,@@(data,"$tipo_movimiento")))
        do dbr.begin(db)

        ref result = movinv.agregarMovimiento(db,params,data)

        do dbr.apps.action.pos(result)
        do dbr.commit(db)
        do dbr.apps.action.ext(result)

		return result

        exception
        {
            do errordet(@false)
            if dbr.in_transaction(db){ do dbr.rollback(db) }
			code = last_error_code()
			error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
	}

	function movinv.genDetalle(&product, almacen, entrada)
	{
		entradas = 0
		salidas = 0

		if entrada { entradas =  @@(product,"#cantidad") }
		else { salidas = @@(product,"#cantidad") }

		abonos = (@@(product,"#costoultimo") * salidas)
		cargos = (@@(product,"#costoultimo") * entradas)
		
		new detail
		{
			@"abonos": abonos
			@"auditado": 0
			@"cargos": cargos
			@"contabilizado": 0
			@"cpromedio": ((abonos + cargos) / (entradas + salidas))
			@"entradas": entradas
			@"resto": entradas
			@"salidas": salidas
			@"tipocambio": 1
			@"valuado": 0
			@"ialmacen": almacen
			@"iproducto": @@(product, "#sys_pk")
		}

		return detail
	}

	function movinv.setSerieLote(&db,&producto,&dcardex,mov)
	{
		ref prod = record.copy(producto,"sys_pk,reqlote,reqserie,lote,fcad,serie")
		
		if parse.bool(@@(prod,"$reqlote"))
		{
			lote = trim(field.dstr(prod,"lote",""))
			fcad = trim(field.dstr(prod,"fcad",""))

			if lote == "" { do rise_error(500,"No se ha indicado un número de lote para "+@@(producto,"$descripcion")) }
			ref dlote = dbr.rec(db,"SELECT sys_pk, numero FROM lote WHERE numero=@lote AND iproducto=@sys_pk LIMIT 1",prod)

			if mov!=@mEntrada && isnull(dlote) { do rise_error(500,"El número de lote indicado para "+@@(producto,"$descripcion")+" no existe, indique uno diferente.") }

			if mov==@mEntrada && isnull(dlote)
			{
				new data
				{
					@"fentrada*": now()
					@"fcaducidad*": @null
					@"numero": lote
					@"iproducto": field.num(prod,"sys_pk")
				}
				if fcad != "" { data<"fcaducidad*"> : str2dt(fcad) }
				ref dlote:record.copy(dbr.save(db,"lote",data),"sys_pk,numero")
			}

			dcardex<"ilote"> : field.num(dlote,"sys_pk")

			ref dclxa = dbr.rec(db,"SELECT sys_pk FROM clotexalmacen WHERE fk_lote_exisxalmacen=@ilote AND ialmacen=@ialmacen LIMIT 1;",dcardex)
			if mov==@mEntrada && isnull(dclxa)
			{
				new data2
				{
					@"cantidad": 0
					@"ialmacen": field.num(dcardex,"ialmacen")
					@"fk_lote_exisxalmacen": field.num(dcardex,"ilote")
				}
				ref dclxa:record.copy(dbr.save(db,"clotexalmacen",data2),"sys_pk")
			}
			// dclxa<"entradas"> : field.num(dcardex,"entradas")
			// dclxa<"salidas"> : field.num(dcardex,"salidas")
			// do dbr.execute(db,"UPDATE clotexalmacen SET sys_timestamp = NOW(), cantidad = IFNULL(cantidad,0) + (@entradas - @salidas) WHERE sys_pk = @sys_pk",dclxa)
		}
		if parse.bool(@@(prod,"$reqserie"))
		{
			serie = trim(field.dstr(prod,"serie",""))

			if serie == "" { do rise_error(500,"No se ha indicado un número de serie para "+@@(producto,"$descripcion")) }
			ref dserie = dbr.rec(db,"SELECT sys_pk, numero, status, IF(iproducto=@sys_pk,TRUE,FALSE) AS used FROM serie WHERE numero=@serie AND iproducto=@sys_pk LIMIT 1",prod)
			
			if mov!=@mEntrada && isnull(dserie) { do rise_error(500,"El número de serie indicado para "+@@(producto,"$descripcion")+" no existe, indique uno diferente.") }
			if mov==@mEntrada && not(isnull(dserie)) && @@(dserie,"#used")
			{ do rise_error(500,"El número de serie "+@@(dserie,"$numero")+" para "+@@(producto,"$descripcion")+" ya está asignado, indique una nueva serie para este producto") }
			if mov==@mSalida && @@(dserie,"#status") != @stt_serie_disponible && @@(dserie,"#status") != @stt_serie_devuelto_por_cliente
			{ do rise_error(500,"El número de serie indicado para "+@@(producto,"$descripcion")+" no se encuentra disponible, indique uno diferente") }

			if mov==@mEntrada && isnull(dserie)
			{
				new data
				{
					@"fentrada*": now()
					@"status": @stt_serie_disponible
					@"numero": serie
					@"iproducto": field.num(prod,"sys_pk")
					@"ialmacen": field.num(dcardex,"ialmacen")
				}
				if field.dnum(dcardex,"ilote",0) > 0 { data<"ilote"> : field.num(dcardex,"ilote") }
				ref dserie:record.copy(dbr.save(db,"serie",data),"sys_pk,numero")
			}
			else if mov==@mTraspaso && not(isnull(dserie))
			{
				if not(isset("@mover_serie")) { @mover_serie = @false }
				if @mover_serie
				{
					dserie<"ialmacen"> : field.num(dcardex,"ialmacen")
					do dbr.execute(db,"UPDATE serie SET ialmacen=@ialmacen WHERE sys_pk=@sys_pk",dserie)
				}
			}

			dcardex<"iserie"> : field.num(dserie,"sys_pk")

			// Establecer salida de la serie
			if mov==@mSalida { do dbr.execute(db,ftext("UPDATE serie SET status=#<@stt_serie_no_disponible> WHERE sys_pk=@sys_pk"),dserie) }
		}
	}

	function movinv.existencias(&db,&params)
	{
		do dbr.apps.action.grant("GE15")

		sql_producto = "
		SELECT
			CONCAT('[',p.codigo,']',' ',p.descripcion) AS tproducto,
			p.unidad,
			dvs.codigo AS cdivisa,
			SUM(IFNULL(ex.existencia,0)) existencia,
            SUM(IFNULL(ex.saldo,0)) saldo,
			IFNULL(p.maximo,0) AS maximo,
			IFNULL(p.minimo,0) AS minimo,
			IFNULL(p.puntoro,0) AS preorden
		FROM producto AS p
			INNER JOIN divisa AS dvs ON p.idivisa = dvs.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk
		WHERE p.sys_pk = @_entity_id
		"

		sql_existencias = "
		SELECT
			alm.sys_pk AS ialmacen,
			alm.codigo AS calmacen,
			alm.descripcion AS dalmacen,
			ex.existencia,
			ex.saldo,
			IFNULL(uf_maximo,0) AS maximo,
			IFNULL(uf_minimo,0) AS minimo,
			IFNULL(uf_preorden,0) AS preorden
		FROM existencias AS ex
			INNER JOIN almacen AS alm ON ex.ialmacen = alm.sys_pk
			LEFT JOIN ut_maxmin AS mm ON mm.ialmacen = alm.sys_pk AND mm.iproducto = @_entity_id
		WHERE ex.fk_producto_iexistencias = @_entity_id
		"

		new data
		{
			@"producto*": dbr.rec(db,sql_producto,params)
			@"existencias*": dbr.list(db,sql_existencias,params)
		}

		return data

		exception
        {
            do errordet(@false)
			code = last_error_code()
			error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
	}

	function movinv.loteserie(&db,&params)
	{
		do dbr.apps.action.grant("GE16")

		sql_producto = "
		SELECT
			CONCAT('[',p.codigo,']',' ',p.descripcion) AS tproducto,
			p.reqlote,
			p.reqserie,
			p.unidad,
			dvs.codigo AS cdivisa
		FROM producto AS p
			INNER JOIN divisa AS dvs ON p.idivisa = dvs.sys_pk
		WHERE p.sys_pk = @_entity_id
		"

		sql_lotes = "
		SELECT
			lot.numero,
			alm.descripcion AS dalmacen,
			lxa.cantidad,
			IFNULL(DATE_FORMAT(lot.fentrada,'%Y-%m-%d'),'') AS fentrada,
			IFNULL(DATE_FORMAT(lot.fcaducidad,'%Y-%m-%d'),'') AS fcaducidad
		FROM lote AS lot
			INNER JOIN clotexalmacen AS lxa ON lxa.fk_lote_exisxalmacen = lot.sys_pk
			INNER JOIN almacen AS alm ON lxa.ialmacen = alm.sys_pk
		WHERE lot.iproducto = @_entity_id
		"

		sql_series = "
		SELECT
			ser.numero,
			alm.descripcion AS dalmacen,
			sts.const AS cstatus,
			IFNULL(DATE_FORMAT(ser.fentrada,'%Y-%m-%d'),'') AS fentrada,
			IFNULL(DATE_FORMAT(ser.fventa,'%Y-%m-%d'),'') AS fventa
		FROM serie AS ser
			INNER JOIN almacen AS alm ON ser.ialmacen = alm.sys_pk
			INNER JOIN cstatusseries AS sts ON ser.status = sts.id
		WHERE ser.iproducto = @_entity_id
		"

		ref producto = dbr.rec(db,sql_producto,params)
		new data
		{
			@"producto*": producto
		}

		if @@(producto,"#reqlote") { data<"data*"> : dbr.list(db,sql_lotes,params) }
		else if @@(producto,"#reqserie") { data<"data*"> : dbr.list(db,sql_series,params) }

		return data

		exception
        {
            do errordet(@false)
			code = last_error_code()
			error = last_error()
            do dbr.apps.action.log()
            do rise_error(code,error)
        }
	}

	@table_name = "cardex"

