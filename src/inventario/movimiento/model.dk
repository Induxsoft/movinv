#include "dkli.dkh"
#!
module "model"
{
	#include "../config.dk"
	#include "../movimientos.dkh"

	// =============== ALMACEN
	function movinv.obtenerAlmacenes(&db, &params)
	{
		sql = "
		SELECT sys_pk, codigo, descripcion, CONCAT(codigo,' - ',descripcion) AS dalmacen
		FROM almacen
		WHERE IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')));"

		return dbr.list(db, sql, params)
	}
	// =============== CATEGORÍA
	function movinv.obtenerCategorias(&db, &params)
	{
		sql = "
		SELECT sys_pk, codigo, descripcion
		FROM categoria
		WHERE tipo = 3
			AND IF(IFNULL(@s,'')='', true, (codigo LIKE CONCAT('%',@s,'%') OR descripcion LIKE CONCAT('%',@s,'%')))
		ORDER BY codigo;"

		return dbr.list(db, sql, params)
	}
	// =============== PRODUCTOS
	function movinv.obtenerProductos(&db, &params)
	{
		sql = "
		SELECT
			p.sys_pk,
			p.codigo,
			p.descripcion,
			p.unidad,
			d.codigo divisa,
			IFNULL(p.costoultimo,0) costoultimo,
			IFNULL(p.saldo,0) saldo,
			SUM(IFNULL(ex.existencia,0)) existencia
		FROM producto p
			INNER JOIN divisa d ON p.idivisa = d.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk
		WHERE NOT IFNULL(p.sys_deleted,0)
			AND p.itipo = 2
			#<conditions>
		GROUP BY p.codigo
		ORDER BY p.codigo
		LIMIT #<@default_max_rows>
		"

		if not(field.exist(params,"fil_almacen")) { params<"fil_almacen"> : -1 }
		if not(field.exist(params,"fil_claseprod")) { params<"fil_claseprod"> : -1 }
		if not(field.exist(params,"fil_linea")) { params<"fil_linea"> : -1 }

		conditions = ""
		if @@(params,"#fil_almacen") > 0 { conditions = conditions + " AND ex.ialmacen = @fil_almacen" }
		if @@(params,"#fil_claseprod") > 0 { conditions = conditions + " AND p.iclase = @fil_claseprod" }
		if @@(params,"#fil_linea") > 0 { conditions = conditions + " AND p.ilinea = @fil_linea" }
		if trim(@@(params,"$s")) != "" { conditions = conditions + " AND (p.codigo LIKE CONCAT('%',@s,'%') OR p.descripcion LIKE CONCAT('%',@s,'%'))" }

		new data
		{
			@"data*": dbr.list(db, ftext(sql), params)
			@"list_almacenes*": movinv.obtenerAlmacenes(db,params)
			@"list_claseproducto*": dbr.list(db,"SELECT id, const FROM cclaseproducto",@null)
			@"list_lineas*": dbr.list(db,"SELECT sys_pk, codigo, descripcion FROM linea WHERE NOT IFNULL(sys_deleted,0) AND clase = @fil_claseprod",params)
		}

		return data
	}

	// =============== MOVIMIENTOS
	function movinv.agregarMovimiento(&db, &params, &data)
	{
		new p{@"referencia":@@(data,"$referencia")}
		if trim(@@(data,"$referencia"))==""{data<"referencia*">:@null}
		if trim(@@(data,"$referencia"))!=""
		{
			ref rec=dbr.rec(db,"select * from cardex where referencia=@referencia",p)
			if not(isnull(rec)){do rise_error(500,"El valor de la referencia ya existe")}
		}
		almacen1 = 0
		almacen2 = 0

		tipo_mov = @@(data, "$tipo_movimiento")

		if field.exist(data, "ialmacen") {
			almacen1 = @@(data,"#ialmacen")
			do field.remove(data, "ialmacen")
		}
		else {
			do rise_error(0, "Se esperaba el parámetro 'ialmacen'")
		}

		if tipo_mov == "traspaso" && not(field.exist(data, "ialmacen2")) {
			do rise_error(0, "Se esperaba el parámetro 'ialmacen2'")
		}
		else  {
			almacen2 = @@(data,"#ialmacen2")
			do field.remove(data, "ialmacen2")
		}

		ref productos = @@(data, "&_productos")
		
		do field.remove(data, "tipo_movimiento")

		if not(isnull(productos)) && list.count(productos) > 0
		{
			ref detalle = list.create()
			
			for i = 0; i < list.count(productos)
			{
				ref producto = list.obj(productos, i)
				ref dcardex = @null

				switch tipo_mov
				{
					case "entrada"
					{
						ref dcardex = movinv.genDetalle(producto, almacen1, @true)
						do list.add(detalle, dcardex)
						break
					}
					case "salida"
					{
						ref dcardex = movinv.genDetalle(producto, almacen1, @false)
						do list.add(detalle, dcardex)
						break
					}
					case "traspaso"
					{
						ref dcardex1 = movinv.genDetalle(producto, almacen1, @false)
						ref dcardex2 = movinv.genDetalle(producto, almacen2, @true)
						do list.add(detalle, dcardex1)
						do list.add(detalle, dcardex2)
						break
					}
				}
			}

			do field.remove(data, "_productos")
			data<"_detalle*">: detalle
			
			using @childs
			{
				member "_detalle"
				{
					@"joinfield": "fk_cardex_movimientos"
					@"keyfield": "sys_pk"
					@"table": "dcardex"
					@"select_query": "SELECT NOW();"
					@"fields": "abonos,auditado,cargos,contabilizado,cpromedio,entradas,resto,salidas,tipocambio,valuado,ialmacen,iproducto"
				}
			}
		}

		@use_transaction = @false
		
		do dbr.begin(db)
		ref res = record.caseinsensitive(entity.create(db, params, data))
		do erp.inventario.aplicar_mov(db,@@(res,"#sys_pk"),@true)
		do dbr.commit(db)
		
		return res

		exception{
			if dbr.in_transaction(db){do dbr.rollback(db)}
			do errordet(@false)
			do rise_error(last_error_code(),last_error())
		}
	}
	function movinv.genDetalle(&product, almacen, entrada)
	{
		entradas = 0
		salidas = 0

		if entrada { entradas =  @@(product,"#cantidad") }
		else { salidas = @@(product,"#cantidad") }

		abonos = (@@(product,"#costoultimo") * salidas)
		cargos = (@@(product,"#costoultimo") * entradas)
		
		new detail
		{
			@"abonos": abonos
			@"auditado": 0
			@"cargos": cargos
			@"contabilizado": 0
			@"cpromedio": ((abonos + cargos) / (entradas + salidas))
			@"entradas": entradas
			@"resto": entradas
			@"salidas": salidas
			@"tipocambio": 1
			@"valuado": 0
			@"ialmacen": almacen
			@"iproducto": @@(product, "#sys_pk")
		}

		return detail
	}

	function movinv.existencias(&db,&params)
	{
		sql_producto = "
		SELECT
			CONCAT('[',p.codigo,']',' ',p.descripcion) AS tproducto,
			p.unidad,
			dvs.codigo AS cdivisa,
			SUM(IFNULL(ex.existencia,0)) existencia,
            SUM(IFNULL(ex.saldo,0)) saldo,
			IFNULL(p.maximo,0) AS maximo,
			IFNULL(p.minimo,0) AS minimo,
			IFNULL(p.puntoro,0) AS preorden
		FROM producto AS p
			INNER JOIN divisa AS dvs ON p.idivisa = dvs.sys_pk
			LEFT JOIN existencias AS ex ON ex.fk_producto_iexistencias = p.sys_pk
		WHERE p.sys_pk = @_entity_id
		"

		sql_existencias = "
		SELECT
			alm.sys_pk AS ialmacen,
			alm.codigo AS calmacen,
			alm.descripcion AS dalmacen,
			ex.existencia,
			ex.saldo,
			IFNULL(uf_maximo,0) AS maximo,
			IFNULL(uf_minimo,0) AS minimo,
			IFNULL(uf_preorden,0) AS preorden
		FROM existencias AS ex
			INNER JOIN almacen AS alm ON ex.ialmacen = alm.sys_pk
			LEFT JOIN ut_maxmin AS mm ON mm.ialmacen = alm.sys_pk AND mm.iproducto = @_entity_id
		WHERE ex.fk_producto_iexistencias = @_entity_id
		"

		new data
		{
			@"producto*": dbr.rec(db,sql_producto,params)
			@"existencias*": dbr.list(db,sql_existencias,params)
		}

		return data
	}

	@table_name = "cardex"

    // point @create 	to entity.create
	// point @read		to entity.read
	// point @update 	to entity.update
	// point @delete 	to entity.delete
	// point @list		to entity.list
    // point @blank	    to entity.blank
}