#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref prods = ifnull(@('&./data'),list.create())
    do scape_special_charactes(prods,"codigo,descripcion,unidad,tipo")

    new fil_almacen
    {
        @"id": "fil_almacen"
        @"datatable*": ifnull(@("&./list_almacenes"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_almacen"
            @"onchange": "document.querySelector('#form_filter').submit()"
        }
        @"first_text": "(Todos los almacenes)"
        @"first_value": "-1"
        @"text_field": "descripcion"
        @"value_field": "sys_pk"
        @"selected": @("#parameters/fil_almacen")
    }

    new fil_claseprod
    {
        @"id": "fil_claseprod"
        @"datatable*": ifnull(@("&./list_claseproducto"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_claseprod"
            @"onchange": "document.querySelector('#form_filter').submit()"
        }
        @"first_text": "(Todas las clases)"
        @"first_value": "-1"
        @"text_field": "const"
        @"value_field": "id"
        @"selected": @("#parameters/fil_claseprod")
    }

    new fil_linea
    {
        @"id": "fil_linea"
        @"datatable*": ifnull(@("&./list_lineas"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_linea"
            @"onchange": "document.querySelector('#form_filter').submit()"
        }
        @"first_text": "(Todas las lineas)"
        @"first_value": "-1"
        @"text_field": "descripcion"
        @"value_field": "sys_pk"
        @"selected": @("#parameters/fil_linea")
    }

    if @("#parameters/fil_claseprod") <= 0 { fil_linea<"attributes/disabled"> : @true }

    new table_definition
    {
        @"datatable*": prods
        @"leyend": "Mostrando los primeros # productos ordenados por código"
        member @"columns"
        {
            member @"codigo"
            {
                @"caption":"Código"
                @"width": "8em"
            }
            member @"descripcion" { @"caption":"Descripción" }
            member @"unidad"
            {
                @"caption":"Unidad"
                @"width": "8em"
                @"align": "center"
            }
            member @"existencia"
            {
                @"caption":"Existencia"
                @"width": "8em"
                @"align": "center"
            }
            member @"saldo"
            {
                @"caption":"Saldo"
                @"width": "8em"
                @"align": "end"
                @"format": @true
                @"thousandssep": @true
                @"decs": 4
            }
            member @"divisa"
            {
                @"caption":"Divisa"
                @"width": "5em"
                @"align": "center"
            }
            member @"_actions"
            {
                @"caption":"Acciones"
                @"no-print":@true
                @"min-width": "5em"
                @"template":ftext('
                    <div style="display:flex;gap:8px;justify-content:center;width:100%;" class="no-print">
                        <a href="${\"#<@INV_GET_DOCUMENTO>\".replace(\"@id\",DataRow.sys_pk)}?almc=#<@("#parameters/fil_almacen")>" style="cursor:pointer; text-decoration:none; padding:0px 8px; background-color:#F5F5F5; color:#000;">Cardex</a>

                        <a href="${\"#<@INV_GET_EXISTENCIAS>\".replace(\"@id\",DataRow.sys_pk)}" style="cursor:pointer; text-decoration:none; padding:0px 8px; background-color:#F5F5F5; color:#000;">Existencias</a>

                        <a href="${\"#<@INV_GET_LOTE_SERIE>\".replace(\"@id\",DataRow.sys_pk)}" style="cursor:pointer; text-decoration:none; padding:0px 8px; background-color:#F5F5F5; color:#000;">Lote/Serie</a>
                    </div>
                ')
            }
        }
    }

    new nav_config
    {
        @"title": "Inventario"
        @"buttons*": @null
        @"urlexit": "/"
        @"main": "GE11,GE12,GE13,GE17"
        @"actions*": dbr.apps.itemactions(@('&database'),"DET077","action","",0)
        @"reports*": dbr.apps.itemactions(@('&database'),"DET077","report","",0)
        @"jscurrentcontext": "movinv.getCurrentContext"
    }

    #$ div(class="container-fluid p-0")
    {
        #$ div(id="top_area")
        {
            #! do uie.printV12FormBar(nav_config)
            #$
            p{$"#<@('$error/message')>"}
            form(action="./" method="GET" id="form_filter" class="no-print mb-1")
            {
                div(class="py-1 w-100 d-flex gap-2 flex-wrap align-items-center")
                {
                    div(class="d-flex gap-2")
                    {
                        div{#! do uie.dbSelect(fil_almacen) } #$
                        div{#! do uie.dbSelect(fil_claseprod) } #$
                        div{#! do uie.dbSelect(fil_linea) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="micontrol10"
                            "text-field"="s"
                            "placeholder"="Buscar por código o descripción"
                            "form"="#form_filter"
                            "value"="#<@@(get,'$s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
                
            }
        }

        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            div(class="show-on-print"){
            div(class="row")
            {
                div(class="col-3 text-start")
                {
                    small(class="d-block"){ $"#<cut(@('$http/session/user/name'),25)>" }
                    small(class="d-block"){ b{$"Impresión: "} $"#<date_str(now(),'dd/MMM/yyyy')>" }
                }
                div(class="col-6 text-center")
                {
                    h4(class=""){$"Informe general del inventario"}
                }
                div(class="col-3 text-end")
                {
                    small(class="d-block" id="lbl_almacen"){$""}
                    small(class="d-block" id="lbl_clase"){$""}
                    small(class="d-block" id="lbl_linea"){$""}
                }
            }}

            
            #! do uie.dbeditable(table_definition,"tbl_productos")
            #$
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }

        script(src="#<@JS_MOVINV>"){$""}
        script(type="text/javascript")
        {$'
            document.addEventListener("DOMContentLoaded", () => {
                const sel_almacen = document.getElementById("fil_almacen");
                const sel_clase = document.getElementById("fil_claseprod");
                const sel_linea = document.getElementById("fil_linea");
                const lbl_almacen = document.getElementById("lbl_almacen");
                const lbl_clase = document.getElementById("lbl_clase");
                const lbl_linea = document.getElementById("lbl_linea");

                const opt_almacen = sel_almacen.options[sel_almacen.selectedIndex];
                lbl_almacen.textContent = opt_almacen.textContent;
                const opt_clase = sel_clase.options[sel_clase.selectedIndex];
                lbl_clase.textContent = opt_clase.textContent;
                const opt_linea = sel_linea.options[sel_linea.selectedIndex];
                lbl_linea.textContent = opt_linea.textContent;

                movinv.tableId = "tbl_productos";
            });
        '}
    }
}