#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)
    ref prods = @('&.')
    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section m-0 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Inventario"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"#<@@(@icons,'ICON_ARROW_CLOCKWISE')>"}
                a(href="#<@INV_ADD_ENTRADA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Entrada"}
                a(href="#<@INV_ADD_SALIDA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Salida"}
                a(href="#<@INV_ADD_TRASPASO>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Traspaso"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" onclick="movinv.goTo('#<@INV_GET_DOCUMENTO>')"){$"Cardex"}
            }
        }
        div
        {
            div(class="d-flex mb-2")
            {
                input(class="induxsoft-form-control flex-grow-1" type="text" id="input_search_prod" url="#<@URL_BUSCAR_PRODUCTO>" placeholder="Buscar producto")
                button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center" id="btn_search_prod"){
                    $"Buscar"
                    $"#<@@(@icons,'ICON_SEARCH')>"
                }
            }
            "edit-table"(class="w-100" id="tbl_productos" "hidde-selector"="true")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="codigo"){$"Código"}
                        "edit-th"(type="NoEditable" field="descripcion"){$"Descripción"}
                        "edit-th"(type="NoEditable" field="unidad"){$"Unidad"}
                        "edit-th"(type="NoEditable" field="tipo"){$"Tipo"}
                        "edit-th"(type="NoEditable" field="existencia"){$"Existencia"}
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script(src="#<@JS_MOVINV>"){$""}
        script{$'
            movinv.tableId = "tbl_productos";
        '}
    }
}