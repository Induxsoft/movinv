#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "dbr.dkh"
    #include "dbr.apps.dkl"
    #include "uielements.v12.dkl"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)
    ref @http_context = @('&http')
    ref get = @@(@http_context,"&request/get")
    ref prods = ifnull(@('&./data'),list.create())
    do scape_special_charactes(prods,"codigo,descripcion,unidad,tipo")

    new fil_almacen
    {
        @"id": "fil_almacen"
        @"datatable*": ifnull(@("&./list_almacenes"),list.create())
        new member @"attributes"
        {
            @"class": "induxsoft-form-select"
            @"name": "fil_almacen"
            @"onchange": "document.querySelector('#form_filter').submit()"
        }
        @"first_text": "(Todos los almacenes)"
        @"first_value": "*"
        @"text_field": "dalmacen"
        @"value_field": "sys_pk"
        @"selected": @("parameters/fil_almacen")
    }

    for i = 0; i < list.count(prods)
    {
        ref prod = list.obj(prods, i)
        prod<"_actions">: ftext('
            <div class="no-print" style="display:flex;justify-content:center;align-items: center; gap: 6px;">
                <a href="#<replace(@INV_GET_DOCUMENTO, "@id", @@(prod,"sys_pk"))>" style="cursor:pointer; text-decoration: none; padding: 0px 8px; background-color: #F5F5F5; color: #000;"><small>Cardex</small></a>
            </div>
        ')
    }

    new table_definition
    {
        @"datatable*": prods
        @"leyend": "Mostrando los primeros # productos ordenados por código"
        member @"columns"
        {
            member @"codigo" { @"caption":"Código" }
            member @"descripcion" { @"caption":"Descripción" }
            member @"unidad" { @"caption":"Unidad" }
            member @"existencia" { @"caption":"Existencia" }
            member @"_actions" { @"caption":"Acciones" }
        }
    }

    header_act::
    { 
        #$ a(href="#<@INV_ADD_ENTRADA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Entrada"}
        a(href="#<@INV_ADD_SALIDA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Salida"}
        a(href="#<@INV_ADD_TRASPASO>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Traspaso"}
    }
    #! point general_act to header_act

    #$ div(class="container-fluid p-0")
    {
        #! do uie.printMainBar(general_act, "Inventario", @true, "")

        #$ div(id="work_area" class="container-section mt-1 p-2 pt-0")
        {
            p{$"#<@('$error/message')>"}
            form(action="./" method="GET" id="form_filter" class="no-print mb-1")
            {
                div(class="py-1 w-100 d-flex gap-2 flex-wrap align-items-center")
                {
                    div(class="d-flex gap-2")
                    {
                        div{#! do uie.dbSelect(fil_almacen) } #$
                    }
                    div(class="flex-grow-1")
                    {
                        "filter-text"(
                            "id"="micontrol10"
                            "text-field"="s"
                            "placeholder"="Buscar por código o descripción"
                            "form"="#form_filter"
                            "value"="#<@@(get,'$s')>"
                            "auto-submit"="true"
                            "class"="w-100"
                        ){$""}
                    }
                }
                
            }
            #! do uie.dbeditable(table_definition,"tbl_productos")
            #$
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }

        script(src="#<@JS_MOVINV>"){$""}
        script{$'
            movinv.tableId = "tbl_productos";
        '}
    }
}