#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"

    do @context.begin(@crud_context)
    ref prods = @('&.')
    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section m-0 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h6(class="tex-no-break m-0"){$"Artículos, servicios y ensambles"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                //a(href="#<@MENU>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"<--"}
                a(href="#<@INV_ADD_ENTRADA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Agregar entrada"}
                a(href="#<@INV_ADD_SALIDA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Agregar salida"}
                a(href="#<@INV_ADD_TRASPASO>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Agregar traspaso"}
                button(type="button" class="btn btn-sm border-secondary induxsoft-corners btn-main-action" onclick="movinv.goTo('#<@INV_GET_DOCUMENTO>')"){$"Consultar documento"}
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action"){$"Refrescar"}
            }
        }
        div
        {
            div(class="d-flex mb-2")
            {
                input(class="induxsoft-form-control flex-grow-1" type="text" id="input_search_prod" url="#<@URL_BUSCAR_PRODUCTO>" placeholder="Buscar producto")
                button(class="btn btn-sm btn-secondary induxsoft-corners" id="btn_search_prod"){$"Buscar"}
            }
            "edit-table"(class="w-100" id="tbl_productos")
            {
                "edit-thead"
                {
                    "edit-tr"
                    {
                        "edit-th"(type="NoEditable" field="codigo"){$"Código"}
                        "edit-th"(type="NoEditable" field="descripcion"){$"Descripción"}
                        "edit-th"(type="NoEditable" field="unidad"){$"Unidad"}
                        "edit-th"(type="NoEditable" field="tipo"){$"Tipo"}
                        "edit-th"(type="NoEditable" field="existencia"){$"Existencia"}
                    }
                }
            }
        }

        p{$"#<@('$error/message')>"}

        script(src="#<@JS_MOVINV>"){$""}
        script{$'
            movinv.tableId = "tbl_productos";
        '}
    }
}