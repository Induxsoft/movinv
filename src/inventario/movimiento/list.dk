#include "dkli.dkh"
#!
module "list.dk"
{
    #include "functions.dkh"
    #include "serialize.dkh"
    #include "../config.dk"
    #include "../_lib/scape_special_charactes2.dk"

    do @context.begin(@crud_context)
    ref prods = @('&.')
    do scape_special_charactes(prods,"codigo,descripcion,unidad,tipo")

    #$
    div(class="container p-0")
    {
        div(id="main_bar" class="row container-section my-2 px-0 py-2 border-bottom")
        {
            div(class="col-4 d-flex align-items-center p-0")
            {
                h5(class="tex-no-break m-0"){$"Inventario"}
            }
            div(class="col-8 d-flex align-items-center justify-content-end p-0 gap-2")
            {
                a(href="./" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Refrescar"){$"#<@@(@icons,'ICON_ARROW_CLOCKWISE')>"}
                a(href="#<@INV_ADD_ENTRADA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Entrada"}
                a(href="#<@INV_ADD_SALIDA>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Salida"}
                a(href="#<@INV_ADD_TRASPASO>" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print"){$"Traspaso"}
                button(class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Imprimir" onclick="window.print()"){$"#<@@(@icons,'PRINTER')>"}
                a(href="/" target="_top" class="btn btn-sm border-secondary induxsoft-corners btn-main-action no-print" title="Salir"){$"#<@@(@icons,'X')>"}
            }
        }
        div(id="work_area" class="container-section pt-2")
        {
            form(action="./" method="GET" id="form_search" class="d-flex mb-2 no-print")
            {
                input(class="induxsoft-form-control flex-grow-1" type="text" name="s" placeholder="Buscar" id="input_search" value='#<@@(@crud_context,"$parameters/s")>')
                button(class="btn btn-sm btn-primary induxsoft-corners d-flex gap-2 align-items-center") {
                    $"Buscar"
                    $"#<@@(@icons,'ICON_SEARCH')>"
                }
            }
            div
            {
                p{$"#<@('$error/message')>"}
                #! lenght = list.count(prods)
                if lenght <= 0
                {
                    message = ""
                    if @@(@crud_context,"$parameters/s") == "" { message = "Sin registros." }
                    else  { message = "Sin resultados." }

                    #$ div(class="text-center")
                    {
                        h6(style="background-color: #F5F5F5; padding: 10rem 0;"){"#<message>"}
                    }
                }
                #! else 
                {
                    #$ div(style="overflow-y:auto;max-height: 75vh;" class="mb-2" id="list_table_container")
                    {
                        table(class="table")
                        {
                            thead
                            {
                                tr
                                {
                                    th(class="h6"){$"Código"}
                                    th(class="h6"){$"Descripción"}
                                    th(class="h6"){$"Unidad"}
                                    th(class="h6"){$"Tipo"}
                                    th(class="h6"){$"Existencia"}
                                    th(class="h6 text-center no-print"){$"Acciones"}
                                }
                            }
                            tbody
                            {
                                $""
                                #! for i = 0; i < list.count(prods)
                                {
                                    ref prod = list.obj(prods, i)

                                    #$ tr
                                    {
                                        td{$"#<@@(prod,'$codigo')>"}
                                        td{$"#<@@(prod,'$descripcion')>"}
                                        td{$"#<@@(prod,'$unidad')>"}
                                        td{$"#<@@(prod,'$tipo')>"}
                                        td{$"#<@@(prod,'$existencia')>"}
                                        td(class="no-print")
                                        {
                                            div(class="d-flex gap-2 justify-content-center")
                                            {
                                                a(href="#<replace(@INV_GET_DOCUMENTO, '@id', @@(prod,'sys_pk'))>" class="btn btn-sm btn-light"){$"Cardex"}
                                            }
                                        }
                                    }
                                } 
                            }
                        }
                    }
                    #! a1 = ftext("Mostrando los primeros #<lenght> Productos ordenados por código.")
                    #$ small(class="text-secondary"){$"#<a1>"}
                }
            }
        }
        div(id="status_bar" class="container-section")
        {
            $""
        }

        script(src="#<@JS_MOVINV>"){$""}
        script{$'
            movinv.tableId = "tbl_productos";
        '}
    }
}